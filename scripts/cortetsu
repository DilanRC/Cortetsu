#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DATA_ROOT="${CORTETSU_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/cortetsu}"
export CORTETSU_DATA_ROOT="$DATA_ROOT"
RUNTIME_ROOT="${CORTETSU_RUNTIME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/cortetsu}"
CURRENT="$RUNTIME_ROOT/current"
PREVIOUS="$RUNTIME_ROOT/previous"
LEGACY_PREVIOUS="$RUNTIME_ROOT/legacy-previous"
SHELL_UNIT="cortetsu-shell.service"

find_repo_root() {
    local candidate="" git_root=""
    local candidates=()
    [[ -z "${CORTETSU_REPO_ROOT:-}" ]] || candidates+=("$CORTETSU_REPO_ROOT")
    candidates+=("$SCRIPT_DIR/..")
    [[ ! -e "$DATA_ROOT/repository" && ! -L "$DATA_ROOT/repository" ]] || candidates+=("$DATA_ROOT/repository")
    git_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -z "$git_root" ]] || candidates+=("$git_root")
    for candidate in "${candidates[@]}"; do
        candidate="$(readlink -f "$candidate" 2>/dev/null || true)"
        if [[ -n "$candidate" && -f "$candidate/cortetsu.toml" && -f "$candidate/scripts/cortetsu" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ROOT="$(find_repo_root || true)"
helper_path() {
    local name="$1"
    if [[ -x "$SCRIPT_DIR/$name" ]]; then
        printf '%s\n' "$SCRIPT_DIR/$name"
    elif [[ -n "$ROOT" && -x "$ROOT/dist/native/$name" ]]; then
        printf '%s\n' "$ROOT/dist/native/$name"
    else
        printf 'ERROR: falta helper nativo %s; ejecuta scripts/build-native.sh\n' "$name" >&2
        return 1
    fi
}
PLATFORM="$(helper_path cortetsu-platform 2>/dev/null || true)"
require_platform() { [[ -x "$PLATFORM" ]] || fail "construye el runtime nativo con scripts/build-native.sh"; }

BASE_INFO="${ROOT:+$ROOT/cortetsu/base/PROVENANCE.md}"

usage() {
    cat <<'EOF'
Cortetsu command entrypoint

Usage:
  cortetsu status                  Show repository and all generation layers
  cortetsu plan                    Preview dotfiles adoption without writing
  cortetsu apply                   Build and promote a dotfiles generation
  cortetsu doctor [--json]         Check packages, runtime, dotfiles and services
  cortetsu generations             Show unified system generations
  cortetsu rollback                Roll back shell + dotfiles + helpers together
  cortetsu system <action>         promote|verify|status|rollback|recover|gc
  cortetsu dotfiles <action>       plan|apply|verify|status|rollback|recover|gc
  cortetsu theme <action>          check|compile|adopt native desktop theme
  cortetsu shell <action>          status|adopt|reconcile|reload|restart|disable|logs|ipc
  cortetsu legacy-processes <action> scan|migrate
  cortetsu config migrate         Import functional preferences to ~/.config/cortetsu
  cortetsu screenshot [-r] [-f]   Open the Cortetsu regional screenshot picker
  cortetsu record <action>        status|stop for GPU Screen Recorder
  cortetsu emoji [-p] [-f]        Emoji/glyph picker (-p) or data refresh (-f)
  cortetsu test                    Run native Rust/Go, Qt and JavaScript regressions
  cortetsu test --developer        Run historical source-contract oracles
  cortetsu recover                Recover interrupted installation or promotion
  cortetsu verify                  Verify the complete promoted Cortetsu system
  cortetsu gc [--keep N]           Show exactly what collection would delete (read-only)
  cortetsu gc --apply --plan-id ID [--keep N] [--archive]
                                  Delete only that reviewed plan; --archive keeps verified tar.gz
  cortetsu audit                   Run status, doctor, tests and verification
  cortetsu install                 Build shell, dotfiles and unified system generation
  cortetsu help                    Show this help
EOF
}

version_cmd() {
    require_repo
    printf 'Cortetsu %s\n' "$(awk -F'"' '/^installed_version[[:space:]]*=/{print $2; exit}' "$ROOT/cortetsu.toml")"
}

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_repo() { [[ -n "$ROOT" ]] || fail "no se encontró el repositorio Cortetsu; ejecuta desde el clon o define CORTETSU_REPO_ROOT"; }
require_file() { [[ -f "$1" ]] || fail "falta archivo requerido: $1"; }
resolved_generation() { readlink -f "$1" 2>/dev/null || true; }

is_managed_generation() {
    local root="$1" required
    [[ -n "$root" ]] || return 1
    for required in shell.qml BUILD_ID BUILD.json provenance.json composition.json wall-utility.json modules/BottomHub.qml modules/calendar/Content.qml modules/calendar/Wrapper.qml; do
        [[ -f "$root/$required" ]] || return 1
    done
}

show_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    if [[ -z "$resolved" || ! -f "$resolved/shell.qml" ]]; then
        printf '  %s=missing\n' "$label"
        return
    fi
    printf '  %s=%s\n' "$label" "$resolved"
    if ! is_managed_generation "$resolved"; then
        printf '  %s_metadata=archived-unmanaged\n' "$label"
        return
    fi
    printf '  %s_build_id=%s\n' "$label" "$(tr -d '\n' < "$resolved/BUILD_ID")"
    "$PLATFORM" show-generation "$label" "$resolved/BUILD.json"

}

dotfiles_cmd() {
    require_repo
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    if [[ "$action" == "apply" ]]; then
        "$PLATFORM" theme adopt --repo "$ROOT"
    fi
    "$PLATFORM" dotfiles "$action" --repo "$ROOT" "$@"
    if [[ "$action" == "apply" || "$action" == "rollback" ]]; then
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
}

system_cmd() {
    require_platform
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    if [[ -n "$ROOT" ]]; then
        "$PLATFORM" system "$action" --repo "$ROOT" "$@"
    else
        "$PLATFORM" system "$action" "$@"
    fi
}

gc_cmd() {
    require_repo
    "$PLATFORM" generation_gc --repo "$ROOT" "$@"
}

theme_cmd() {
    require_repo
    local action="${1:-check}"
    [[ $# -eq 0 ]] || shift
    "$PLATFORM" theme "$action" --repo "$ROOT" "$@"
}

reconcile_shell_lifecycle() {
    require_repo
    "$PLATFORM" shell_lifecycle migrate
}

shell_reload() {
    local pid after
    pid="$(systemctl --user show "$SHELL_UNIT" -p MainPID --value 2>/dev/null || true)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || fail "$SHELL_UNIT no tiene un MainPID válido"
    systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no está activo"
    qs ipc --pid "$pid" call cortetsu-shell reload || fail "no se pudo solicitar la recarga suave de Quickshell"
    sleep 1
    systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT dejó de estar activo después de la recarga suave"
    after="$(systemctl --user show "$SHELL_UNIT" -p MainPID --value 2>/dev/null || true)"
    [[ "$after" == "$pid" ]] || fail "la recarga suave cambió el proceso de Quickshell: antes=$pid después=$after"
    printf 'Cortetsu shell: recarga suave completada en el mismo proceso (%s)\n' "$pid"
}

shell_ipc() {
    local target="${1:-}" method="${2:-}" pid
    [[ -n "$target" && -n "$method" ]] || fail "uso: cortetsu shell ipc <target> <method> [args...]"
    shift 2
    pid="$(systemctl --user show "$SHELL_UNIT" -p MainPID --value 2>/dev/null || true)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || fail "$SHELL_UNIT no tiene un MainPID válido"
    systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no está activo"
    qs ipc --pid "$pid" call "$target" "$method" "$@"
}

# Quickshell processes of this user started with `-p` inside RUNTIME_ROOT and
# outside the shell unit. Other Quickshell configs are never matched.
unsupervised_cortetsu_qs_pids() {
    local runtime pid path arg next cgroup
    runtime="$(realpath -ms "$RUNTIME_ROOT")"
    for pid in $(pgrep -u "$(id -u)" -x qs || true); do
        path="" next=0
        while IFS= read -r -d '' arg; do
            if (( next )); then path="$arg"; break; fi
            case "$arg" in
                -p|--path) next=1 ;;
                --path=*) path="${arg#--path=}"; break ;;
            esac
        done < "/proc/$pid/cmdline" 2>/dev/null || continue
        [[ -n "$path" ]] || continue
        path="$(realpath -ms "$path")"
        [[ "$path" == "$runtime" || "$path" == "$runtime/"* ]] || continue
        cgroup="$(cat "/proc/$pid/cgroup" 2>/dev/null || true)"
        [[ "$cgroup" != *"/$SHELL_UNIT"* ]] || continue
        printf '%s\n' "$pid"
    done
}

stop_unsupervised_cortetsu_qs() {
    local pids pid alive
    pids="$(unsupervised_cortetsu_qs_pids)"
    [[ -n "$pids" ]] || return 0
    for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
    for _ in $(seq 1 30); do
        alive=0
        # A zombie has exited; only its parent can still reap it.
        for pid in $pids; do
            [[ "$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null)" =~ ^[^ZX]$ ]] && alive=1
        done
        (( alive )) || return 0
        sleep 0.1
    done
    fail "Quickshell de Cortetsu sin supervisar no terminó tras SIGTERM: $pids"
}

shell_cmd() {
    require_repo
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    case "$action" in
        status)
            systemctl --user status "$SHELL_UNIT" --no-pager "$@" || true
            ;;
        adopt)
            require_file "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SHELL_UNIT"
            reconcile_shell_lifecycle
            systemctl --user daemon-reload
            stop_unsupervised_cortetsu_qs
            systemctl --user enable --now "$SHELL_UNIT"
            systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no quedó activo"
            printf 'Cortetsu shell supervision: adopted by systemd --user\n'
            ;;
        reconcile)
            reconcile_shell_lifecycle
            ;;
        reload)
            shell_reload
            ;;
        ipc)
            shell_ipc "$@"
            ;;
        restart)
            systemctl --user daemon-reload
            systemctl --user restart "$SHELL_UNIT"
            systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no quedó activo"
            ;;
        disable)
            systemctl --user disable --now "$SHELL_UNIT" || true
            ;;
        logs)
            journalctl --user -u "$SHELL_UNIT" -n "${1:-80}" --no-pager
            ;;
        *) fail "acción de shell desconocida: $action" ;;
    esac
}

status_cmd() {
    printf 'Cortetsu\nRoot: %s\nStage: unified-system-generations\n' "${ROOT:-unavailable}"
    if [[ -n "$BASE_INFO" && -f "$BASE_INFO" ]]; then
        printf '\nShell base contract:\n'; sed 's/^/  /' "$BASE_INFO"
    fi
    if [[ -n "$ROOT" ]] && git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch revision dirty
        branch="$(git -C "$ROOT" branch --show-current)"
        revision="$(git -C "$ROOT" rev-parse --short HEAD)"
        [[ -z "$(git -C "$ROOT" status --porcelain)" ]] && dirty=no || dirty=yes
        printf '\nGit:\n  branch=%s\n  revision=%s\n  dirty=%s\n' "${branch:-detached}" "$revision" "$dirty"
    fi
    printf '\nShell generations:\n  root=%s\n' "$RUNTIME_ROOT"
    show_generation current "$CURRENT"
    show_generation previous "$PREVIOUS"
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then show_generation archived_previous "$LEGACY_PREVIOUS"; fi
    if [[ -n "$ROOT" ]]; then
        printf '\n'; dotfiles_cmd status
    fi
    if [[ -x "$PLATFORM" ]]; then
        printf '\n'; system_cmd status
    fi
    printf '\nCanonical namespace:\n  commands=cortetsu-*\n  config=~/.config/cortetsu\n  state=~/.local/state/cortetsu\n  data=~/.local/share/cortetsu\n'
}

run_node_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; node "$ROOT/$relative"; }
run_bash_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; bash "$ROOT/$relative"; }
run_qml_test() {
    local relative="$1" test_files=()
    require_repo
    [[ -d "$ROOT/$relative" ]] || fail "falta directorio de tests QML: $relative"
    test_files=("$ROOT/$relative"/tst_*.qml)
    [[ -f "${test_files[0]}" ]] || fail "no hay tests tst_*.qml en $relative"
    require_file /usr/lib/qt6/bin/qmltestrunner
    printf '==> Qt Quick Test: %s\n' "$relative"
    QT_QPA_PLATFORM=offscreen timeout 300 /usr/lib/qt6/bin/qmltestrunner -input "$ROOT/$relative"
}

run_quickshell_fixture() {
    local relative="$1" marker="$2" output
    require_repo
    require_file "$ROOT/$relative"
    printf '==> Quickshell QML fixture: %s\n' "$relative"
    output="$(timeout 10s qs -p "$ROOT/$relative" --no-color 2>&1)" || {
        printf '%s\n' "$output" >&2
        fail "Quickshell fixture failed: $relative"
    }
    printf '%s\n' "$output"
    [[ "$output" == *"$marker"* ]] || fail "Quickshell fixture did not report $marker"
    [[ "$output" != *"Binding loop"* ]] || fail "Quickshell fixture reported a binding loop: $relative"
}

legacy_processes_cmd() {
    require_repo
    local action="${1:-scan}"
    [[ "$action" == "scan" || "$action" == "migrate" ]] || fail "acción legacy-processes inválida: $action"
    "$PLATFORM" migrate_legacy_processes "$action"
}

config_cmd() {
    require_repo
    [[ "${1:-}" == "migrate" ]] || fail "acción config inválida: migrate"
    "$PLATFORM" migrate_config
}

screenshot_cmd() {
    local freeze=false arg
    for arg in "$@"; do
        case "$arg" in
            -r|--region) ;;
            -f|--freeze) freeze=true ;;
            *) fail "opción de screenshot desconocida: $arg" ;;
        esac
    done
    [[ -f "$CURRENT/shell.qml" ]] || fail "no hay un runtime Cortetsu promovido"
    if "$freeze"; then
        exec qs -p "$CURRENT" ipc call picker openFreeze
    fi
    exec qs -p "$CURRENT" ipc call picker open
}

record_cmd() {
    local action="${1:-status}"
    [[ "$action" == "status" || "$action" == "stop" ]] || fail "acción record inválida: $action"
    exec "$(helper_path cortetsu-record)" "$action"
}

emoji_cmd() {
    for arg in "$@"; do
        case "$arg" in
            -p|--picker|-f|--fetch) ;;
            *) fail "opción de emoji desconocida: $arg" ;;
        esac
    done
    exec "$(helper_path cortetsu-emoji)" "$@"
}

test_cmd() {
    require_repo
    if [[ "${1:-}" == --developer ]]; then
        exec bash "$ROOT/scripts/verification/developer-regressions.sh"
    fi
    [[ $# == 0 ]] || fail "uso: cortetsu test [--developer]"
    for crate in keyboards notification-helper display-presets-rs prune-applications-rs rescue platform-rs hardware-runtime-rs desktop-runtime-rs; do
        cargo test --locked --manifest-path "$ROOT/cortetsu/$crate/Cargo.toml"
    done
    (cd "$ROOT/cortetsu/protocol" && go test ./...)
    run_node_test "cortetsu/tests/test-wallpaper-search.node.js"
    run_node_test "scripts/features/test-ascension-motion.js"
    run_node_test "scripts/features/test-connectivity-wifi-policy.cjs"
    run_node_test "scripts/features/test-connectivity-bluetooth.mjs"
    run_node_test "scripts/features/test-hypr-shell-layer-rules.cjs"
    local directory
    for directory in focus components hardware hypr keyboards settings surfaces calendar pomodoro bottomhub polkit prompt; do
        run_qml_test "cortetsu/tests/qml/$directory"
    done
    run_qml_test "cortetsu/modules/wallpaper/tests"
    run_quickshell_fixture "cortetsu/tests/qml/bottomhub/fixture_ScriptModelIdentity.qml" "SCRIPT_MODEL_IDENTITY_PASS"
    run_quickshell_fixture "cortetsu/StartupPageFixture.qml" "STARTUP_PAGE_PASS"
    run_quickshell_fixture "cortetsu/ExclusionsFixture.qml" "EXCLUSIONS_PASS"
    run_quickshell_fixture "cortetsu/ConnectivityWifiFixture.qml" "WIFI_OBSERVED_PASS"
    run_quickshell_fixture "cortetsu/SecretPromptFixture.qml" "SECRETPROMPT_PASS"
    bash "$ROOT/cortetsu/tests/test-qml-compile-check.sh"
    printf '\nCortetsu native regressions passed.\n'
}

verify_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    [[ -n "$resolved" ]] || fail "no existe la generación $label: $link"
    is_managed_generation "$resolved" || fail "$label no es una generación Cortetsu administrada: $resolved"
    "$PLATFORM" verify-shell-metadata "$resolved/BUILD.json"
    local legacy_checkpoint=unknown
    if [[ -f "$DATA_ROOT/system/current/SYSTEM.json" ]]; then
        legacy_checkpoint="$("$PLATFORM" metadata "$DATA_ROOT/system/current/SYSTEM.json" legacySourceSystem)"
    fi
    if [[ "$label" == current && "$legacy_checkpoint" == unknown ]]; then
        "$PLATFORM" validate-runtime "$resolved"
    else
        "$PLATFORM" validate-runtime "$resolved" --historical
    fi
    printf 'PASS: %s generation %s\n' "$label" "$resolved"
}

verify_cmd() {
    require_repo
    verify_generation current "$CURRENT"
    local current_resolved previous_resolved archived_resolved
    current_resolved="$(resolved_generation "$CURRENT")"
    if [[ -e "$PREVIOUS" || -L "$PREVIOUS" ]]; then
        previous_resolved="$(resolved_generation "$PREVIOUS")"
        if is_managed_generation "$previous_resolved"; then
            verify_generation previous "$PREVIOUS"
            [[ "$current_resolved" != "$previous_resolved" ]] || fail "current y previous apuntan a la misma generación"
        elif [[ -n "$previous_resolved" && -f "$previous_resolved/shell.qml" ]]; then
            printf 'WARN: previous pre-v2 detectado; cortetsu install lo archivará fuera del rollback automático: %s\n' "$previous_resolved" >&2
        fi
    fi
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then
        archived_resolved="$(resolved_generation "$LEGACY_PREVIOUS")"
        [[ -z "$archived_resolved" || ! -f "$archived_resolved/shell.qml" ]] || printf 'INFO: snapshot pre-v2 archivado: %s\n' "$archived_resolved"
    fi
    theme_cmd check
    dotfiles_cmd verify
    system_cmd verify
    printf '\nCortetsu promoted system verified.\n'
}

doctor_cmd() {
    require_repo
    "$PLATFORM" doctor --repo "$ROOT" "$@"
}

plan_cmd() { dotfiles_cmd plan "$@"; }
apply_cmd() { dotfiles_cmd apply "$@"; }
rollback_cmd() {
    system_cmd rollback "$@"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    if systemctl --user is-active --quiet cortetsu-wallpaper-color.service 2>/dev/null; then
        systemctl --user restart cortetsu-wallpaper-color.service || printf 'WARN: no se pudo reiniciar wallpaper-color tras rollback\n' >&2
    fi
    if systemctl --user is-enabled --quiet cortetsu-power-auto.service 2>/dev/null \
        && systemctl --user is-active --quiet cortetsu-power-auto.service 2>/dev/null; then
        systemctl --user restart cortetsu-power-auto.service || printf 'WARN: no se pudo reiniciar power-auto tras rollback\n' >&2
    fi
}
audit_cmd() { require_repo; status_cmd; printf '\n===== DOCTOR =====\n'; doctor_cmd; printf '\n===== REPOSITORY TESTS =====\n'; test_cmd; printf '\n===== PROMOTED SYSTEM =====\n'; verify_cmd; }
install_cmd() { require_repo; require_file "$ROOT/scripts/install-cortetsu.sh"; printf 'Cortetsu: building shell, dotfiles and unified system generation.\n'; bash "$ROOT/scripts/install-cortetsu.sh" "$@"; }

recover_cmd() {
    require_platform
    mkdir -p "$DATA_ROOT"
    [[ ! -L "$DATA_ROOT/install.lock" ]] || fail "install.lock es un enlace"
    exec 8>>"$DATA_ROOT/install.lock"
    flock -n 8 || fail "hay una instalación de Cortetsu en curso"
    "$PLATFORM" install-transaction recover
    "$PLATFORM" dotfiles recover
    "$PLATFORM" system recover
}
command="${1:-help}"
shift || true
case "$command" in
    help|-h|--help|--version|-V|version|install|test) ;;
    *) require_platform ;;
esac
case "$command" in
    --version|-V|version) version_cmd "$@" ;;
    status) status_cmd "$@" ;;
    plan) plan_cmd "$@" ;;
    apply) apply_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    generations) system_cmd status "$@" ;;
    rollback) rollback_cmd "$@" ;;
    system) system_cmd "$@" ;;
    dotfiles) dotfiles_cmd "$@" ;;
    theme) theme_cmd "$@" ;;
    shell) shell_cmd "$@" ;;
    legacy-processes) legacy_processes_cmd "$@" ;;
    config) config_cmd "$@" ;;
    screenshot) screenshot_cmd "$@" ;;
    record) record_cmd "$@" ;;
    emoji) emoji_cmd "$@" ;;
    test) test_cmd "$@" ;;
    verify) verify_cmd "$@" ;;
    recover) recover_cmd "$@" ;;
    gc) gc_cmd "$@" ;;
    audit) audit_cmd "$@" ;;
    install) install_cmd "$@" ;;
    help|-h|--help) usage ;;
    *) printf 'ERROR: unknown command: %s\n\n' "$command" >&2; usage >&2; exit 64 ;;
esac
