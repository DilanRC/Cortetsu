verify_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    [[ -n "$resolved" ]] || fail "no existe la generación $label: $link"
    is_managed_generation "$resolved" || fail "$label no es una generación Cortetsu administrada: $resolved"
    python3 - "$resolved/BUILD.json" <<'PY'
import json, sys
from pathlib import Path
build = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert build.get("schema") == 1
assert build.get("sourceProject") == "Cortetsu"
assert isinstance(build.get("repositoryRevision"), str) and build["repositoryRevision"]
PY
    printf 'PASS: %s generation %s\n' "$label" "$resolved"
}

verify_cmd() {
    require_repo
    verify_generation current "$CURRENT"
    local current_resolved previous_resolved archived_resolved
    current_resolved="$(resolved_generation "$CURRENT")"
    if [[ -e "$PREVIOUS" || -L "$PREVIOUS" ]]; then
        previous_resolved="$(resolved_generation "$PREVIOUS")"
        if is_managed_generation "$previous_resolved"; then
            verify_generation previous "$PREVIOUS"
            [[ "$current_resolved" != "$previous_resolved" ]] || fail "current y previous apuntan a la misma generación"
        elif [[ -n "$previous_resolved" && -f "$previous_resolved/shell.qml" ]]; then
            printf 'WARN: previous pre-v2 detectado; cortetsu install lo archivará fuera del rollback automático: %s\n' "$previous_resolved" >&2
        fi
    fi
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then
        archived_resolved="$(resolved_generation "$LEGACY_PREVIOUS")"
        [[ -z "$archived_resolved" || ! -f "$archived_resolved/shell.qml" ]] || printf 'INFO: snapshot pre-v2 archivado: %s\n' "$archived_resolved"
    fi
    theme_cmd check
    run_python_test "scripts/features/test-cortetsu-quality.py"
    run_python_test "scripts/features/test-cortetsu-settings.py"
    run_python_test "scripts/features/eval-cortetsu-settings.py"
    run_python_test "scripts/features/test-cortetsu-dashboard.py"
    run_python_test "scripts/features/eval-cortetsu-dashboard.py"
    run_python_test "scripts/features/test-cortetsu-lock.py"
    run_python_test "scripts/features/eval-cortetsu-lock.py"
    run_python_test "scripts/features/test-cortetsu-launcher-identity.py"
    run_python_test "scripts/features/eval-cortetsu-launcher-identity.py"
    run_python_test "scripts/features/test-cortetsu-launcher-host.py"
    run_python_test "scripts/features/eval-cortetsu-launcher-host.py"
    run_python_test "scripts/features/test-cortetsu-osd-identity.py"
    run_python_test "scripts/features/eval-cortetsu-osd-identity.py"
    run_python_test "scripts/features/test-cortetsu-system-cluster.py"
    run_python_test "scripts/features/eval-cortetsu-system-cluster.py"
    run_python_test "scripts/features/test-retained-surfaces-host.py"
    run_python_test "scripts/features/eval-retained-surfaces-host.py"
    run_python_test "cortetsu/tests/test-runtime-contract.py"
    run_bash_test "cortetsu/tests/test-calendar-readonly.sh"
    dotfiles_cmd verify
    system_cmd verify
    printf '\nCortetsu promoted system verified.\n'
}

doctor_cmd() {
    require_repo
    require_file "$ROOT/core/doctor.py"
    python3 "$ROOT/core/doctor.py" --repo "$ROOT" "$@"
}

plan_cmd() { dotfiles_cmd plan "$@"; }
apply_cmd() { dotfiles_cmd apply "$@"; }
rollback_cmd() { system_cmd rollback "$@"; systemctl --user daemon-reload >/dev/null 2>&1 || true; }
audit_cmd() { require_repo; status_cmd; printf '\n===== DOCTOR =====\n'; doctor_cmd; printf '\n===== REPOSITORY TESTS =====\n'; test_cmd; printf '\n===== PROMOTED SYSTEM =====\n'; verify_cmd; }
install_cmd() { require_repo; require_file "$ROOT/scripts/install-cortetsu.sh"; printf 'Cortetsu: building shell, dotfiles and unified system generation.\n'; bash "$ROOT/scripts/install-cortetsu.sh"; }

command="${1:-help}"
shift || true
case "$command" in
    --version|-V|version) version_cmd "$@" ;;
    status) status_cmd "$@" ;;
    plan) plan_cmd "$@" ;;
    apply) apply_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    generations) system_cmd status "$@" ;;
    rollback) rollback_cmd "$@" ;;
    system) system_cmd "$@" ;;
    dotfiles) dotfiles_cmd "$@" ;;
    theme) theme_cmd "$@" ;;
    shell) shell_cmd "$@" ;;
    legacy-processes) legacy_processes_cmd "$@" ;;
    config) config_cmd "$@" ;;
    screenshot) screenshot_cmd "$@" ;;
    record) record_cmd "$@" ;;
    emoji) emoji_cmd "$@" ;;
    test) test_cmd "$@" ;;
    verify) verify_cmd "$@" ;;
    audit) audit_cmd "$@" ;;
    install) install_cmd "$@" ;;
    help|-h|--help) usage ;;
    *) printf 'ERROR: unknown command: %s\n\n' "$command" >&2; usage >&2; exit 64 ;;
esac
