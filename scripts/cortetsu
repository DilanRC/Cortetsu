#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
DATA_ROOT="${CORTETSU_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/cortetsu}"
RUNTIME_ROOT="${CORTETSU_RUNTIME_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/cortetsu}"
CURRENT="$RUNTIME_ROOT/current"
PREVIOUS="$RUNTIME_ROOT/previous"
LEGACY_PREVIOUS="$RUNTIME_ROOT/legacy-previous"
SHELL_UNIT="cortetsu-shell.service"

find_repo_root() {
    local candidate="" git_root=""
    local candidates=()
    [[ -z "${CORTETSU_REPO_ROOT:-}" ]] || candidates+=("$CORTETSU_REPO_ROOT")
    candidates+=("$SCRIPT_DIR/..")
    [[ ! -e "$DATA_ROOT/repository" && ! -L "$DATA_ROOT/repository" ]] || candidates+=("$DATA_ROOT/repository")
    git_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -z "$git_root" ]] || candidates+=("$git_root")
    for candidate in "${candidates[@]}"; do
        candidate="$(readlink -f "$candidate" 2>/dev/null || true)"
        if [[ -n "$candidate" && -f "$candidate/cortetsu.toml" && -f "$candidate/scripts/cortetsu" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ROOT="$(find_repo_root || true)"
BASE_INFO="${ROOT:+$ROOT/cortetsu/base/PROVENANCE.md}"

usage() {
    cat <<'EOF'
Cortetsu command entrypoint

Usage:
  cortetsu status                  Show repository and all generation layers
  cortetsu plan                    Preview dotfiles adoption without writing
  cortetsu apply                   Build and promote a dotfiles generation
  cortetsu doctor [--json]         Check packages, runtime, dotfiles and services
  cortetsu generations             Show unified system generations
  cortetsu rollback                Roll back shell + dotfiles as one system
  cortetsu system <action>         promote|verify|status|rollback|gc
  cortetsu dotfiles <action>       plan|apply|verify|status|rollback|gc
  cortetsu theme <action>          check|compile|adopt native desktop theme
  cortetsu shell <action>          status|adopt|reconcile|restart|disable|logs
  cortetsu legacy-processes <action> scan|migrate
  cortetsu config migrate         Import functional preferences to ~/.config/cortetsu
  cortetsu screenshot [-r] [-f]   Open the Cortetsu regional screenshot picker
  cortetsu record <action>        status|stop for GPU Screen Recorder
  cortetsu emoji [-p] [-f]        Emoji/glyph picker (-p) or data refresh (-f)
  cortetsu test                    Run repository, UX and transaction regressions
  cortetsu verify                  Verify the complete promoted Cortetsu system
  cortetsu audit                   Run status, doctor, tests and verification
  cortetsu install                 Build shell, dotfiles and unified system generation
  cortetsu help                    Show this help
EOF
}

version_cmd() {
    require_repo
    printf 'Cortetsu %s\n' "$(awk -F'"' '/^installed_version[[:space:]]*=/{print $2; exit}' "$ROOT/cortetsu.toml")"
}

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_repo() { [[ -n "$ROOT" ]] || fail "no se encontró el repositorio Cortetsu; ejecuta desde el clon o define CORTETSU_REPO_ROOT"; }
require_file() { [[ -f "$1" ]] || fail "falta archivo requerido: $1"; }
resolved_generation() { readlink -f "$1" 2>/dev/null || true; }

is_managed_generation() {
    local root="$1" required
    [[ -n "$root" ]] || return 1
    for required in shell.qml BUILD_ID BUILD.json provenance.json composition.json modules/BottomHub.qml modules/calendar/Content.qml modules/calendar/Wrapper.qml; do
        [[ -f "$root/$required" ]] || return 1
    done
}

show_generation() {
    local label="$1" link="$2" resolved
    resolved="$(resolved_generation "$link")"
    if [[ -z "$resolved" || ! -f "$resolved/shell.qml" ]]; then
        printf '  %s=missing\n' "$label"
        return
    fi
    printf '  %s=%s\n' "$label" "$resolved"
    if ! is_managed_generation "$resolved"; then
        printf '  %s_metadata=archived-unmanaged\n' "$label"
        return
    fi
    printf '  %s_build_id=%s\n' "$label" "$(tr -d '\n' < "$resolved/BUILD_ID")"
    python3 - "$label" "$resolved/BUILD.json" <<'PY'
import json, sys
from pathlib import Path
label, path = sys.argv[1:]
try:
    payload = json.loads(Path(path).read_text(encoding="utf-8"))
except (OSError, ValueError):
    print(f"  {label}_metadata=invalid")
else:
    print(f"  {label}_source={payload.get('sourceProject', 'unknown')}@{payload.get('repositoryRevision', 'unknown')}")
    print(f"  {label}_revision={payload.get('repositoryRevision', 'unknown')}")
PY
}

dotfiles_cmd() {
    require_repo
    require_file "$ROOT/core/dotfiles.py"
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    python3 "$ROOT/core/dotfiles.py" "$action" --repo "$ROOT" "$@"
    if [[ "$action" == "apply" || "$action" == "rollback" ]]; then
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
}

system_cmd() {
    require_repo
    require_file "$ROOT/core/system.py"
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    python3 "$ROOT/core/system.py" "$action" --repo "$ROOT" "$@"
}

theme_cmd() {
    require_repo
    require_file "$ROOT/core/theme.py"
    local action="${1:-check}"
    [[ $# -eq 0 ]] || shift
    python3 "$ROOT/core/theme.py" "$action" --repo "$ROOT" "$@"
}

reconcile_shell_lifecycle() {
    require_repo
    require_file "$ROOT/core/shell_lifecycle.py"
    python3 "$ROOT/core/shell_lifecycle.py" migrate
}

shell_cmd() {
    require_repo
    local action="${1:-status}"
    [[ $# -eq 0 ]] || shift
    case "$action" in
        status)
            systemctl --user status "$SHELL_UNIT" --no-pager "$@" || true
            ;;
        adopt)
            require_file "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SHELL_UNIT"
            reconcile_shell_lifecycle
            systemctl --user daemon-reload
            pkill -TERM -x qs >/dev/null 2>&1 || true
            sleep 1
            systemctl --user enable --now "$SHELL_UNIT"
            systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no quedó activo"
            printf 'Cortetsu shell supervision: adopted by systemd --user\n'
            ;;
        reconcile)
            reconcile_shell_lifecycle
            ;;
        restart)
            systemctl --user daemon-reload
            systemctl --user restart "$SHELL_UNIT"
            systemctl --user is-active --quiet "$SHELL_UNIT" || fail "$SHELL_UNIT no quedó activo"
            ;;
        disable)
            systemctl --user disable --now "$SHELL_UNIT" || true
            ;;
        logs)
            journalctl --user -u "$SHELL_UNIT" -n "${1:-80}" --no-pager
            ;;
        *) fail "acción de shell desconocida: $action" ;;
    esac
}

status_cmd() {
    printf 'Cortetsu\nRoot: %s\nStage: unified-system-generations\n' "${ROOT:-unavailable}"
    if [[ -n "$BASE_INFO" && -f "$BASE_INFO" ]]; then
        printf '\nShell base contract:\n'; sed 's/^/  /' "$BASE_INFO"
    fi
    if [[ -n "$ROOT" ]] && git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local branch revision dirty
        branch="$(git -C "$ROOT" branch --show-current)"
        revision="$(git -C "$ROOT" rev-parse --short HEAD)"
        [[ -z "$(git -C "$ROOT" status --porcelain)" ]] && dirty=no || dirty=yes
        printf '\nGit:\n  branch=%s\n  revision=%s\n  dirty=%s\n' "${branch:-detached}" "$revision" "$dirty"
    fi
    printf '\nShell generations:\n  root=%s\n' "$RUNTIME_ROOT"
    show_generation current "$CURRENT"
    show_generation previous "$PREVIOUS"
    if [[ -e "$LEGACY_PREVIOUS" || -L "$LEGACY_PREVIOUS" ]]; then show_generation archived_previous "$LEGACY_PREVIOUS"; fi
    if [[ -n "$ROOT" && -f "$ROOT/core/dotfiles.py" ]]; then
        printf '\n'; dotfiles_cmd status
    fi
    if [[ -n "$ROOT" && -f "$ROOT/core/system.py" ]]; then
        printf '\n'; system_cmd status
    fi
    printf '\nCanonical namespace:\n  commands=cortetsu-*\n  config=~/.config/cortetsu\n  state=~/.local/state/cortetsu\n  data=~/.local/share/cortetsu\n'
}

run_python_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; python3 "$ROOT/$relative"; }
run_node_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; node "$ROOT/$relative"; }
run_bash_test() { local relative="$1"; require_repo; require_file "$ROOT/$relative"; printf '==> %s\n' "$relative"; bash "$ROOT/$relative"; }

legacy_processes_cmd() {
    require_repo
    require_file "$ROOT/core/migrate_legacy_processes.py"
    local action="${1:-scan}"
    [[ "$action" == "scan" || "$action" == "migrate" ]] || fail "acción legacy-processes inválida: $action"
    python3 "$ROOT/core/migrate_legacy_processes.py" "$action"
}

config_cmd() {
    require_repo
    [[ "${1:-}" == "migrate" ]] || fail "acción config inválida: migrate"
    require_file "$ROOT/core/migrate_config.py"
    python3 "$ROOT/core/migrate_config.py"
}

screenshot_cmd() {
    local freeze=false arg
    for arg in "$@"; do
        case "$arg" in
            -r|--region) ;;
            -f|--freeze) freeze=true ;;
            *) fail "opción de screenshot desconocida: $arg" ;;
        esac
    done
    [[ -f "$CURRENT/shell.qml" ]] || fail "no hay un runtime Cortetsu promovido"
    if "$freeze"; then
        exec qs -p "$CURRENT" ipc call picker openFreeze
    fi
    exec qs -p "$CURRENT" ipc call picker open
}

record_cmd() {
    local action="${1:-status}"
    [[ "$action" == "status" || "$action" == "stop" ]] || fail "acción record inválida: $action"
    exec cortetsu-record "$action"
}

emoji_cmd() {
    for arg in "$@"; do
        case "$arg" in
            -p|--picker|-f|--fetch) ;;
            *) fail "opción de emoji desconocida: $arg" ;;
        esac
    done
    exec cortetsu-emoji "$@"
}

