#%PAM-1.0

auth    required                    pam_faillock.so     preauth
# nodelay: a wrong password answers at once; pam_faillock still locks the
# account after repeated failures, which is what limits guessing.
auth    [success=1 default=bad]     pam_unix.so         nullok nodelay
auth    [default=die]               pam_faillock.so     authfail
auth    required                    pam_faillock.so     authsucc
