    "startupPhase": "conditional",
    "condition": "CortetsuAudio se carga y cava está instalado",
    "command": [
      "cava"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:connectivity-monitor",
    "name": "Connectivity event monitor",
    "source": "services/ConnectivityNmAdapter.qml",
    "qmlId": "monitor",
    "startupPhase": "always-on",
    "condition": "Connectivity se carga junto a la barra y Bottom Hub",
    "command": [
      "nmcli",
      "monitor"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:connectivity-command",
    "name": "Connectivity metadata and UUID operations",
    "source": "services/ConnectivityNmAdapter.qml",
    "qmlId": "worker",
    "startupPhase": "conditional",
    "condition": "Al cargar Connectivity, recibir un evento o solicitar una operación",
    "command": [],
    "commandSource": "worker.command",
    "commandDisplay": "Metadatos y operaciones por UUID",
    "manageable": false
  },
  {
    "id": "cortetsu:network-password-copy",
    "name": "Copy saved Wi-Fi password",
    "source": "services/CortetsuSettingsNetwork.qml",
    "qmlId": "passwordCopy",
    "startupPhase": "on-demand",
    "condition": "Únicamente al pulsar copiar contraseña de un perfil",
    "command": [
      "nmcli",
      "--wait",
      "5",
      "--show-secrets",
      "--escape",
      "no",
      "-g",
      "802-11-wireless-security.psk",
      "connection",
      "show",
      "uuid",
      "*"
    ],
    "commandDisplay": "Consulta efímera del secreto por UUID",
    "manageable": false
  },
  {
    "id": "cortetsu:network-password-clipboard",
    "name": "Offer copied Wi-Fi password",
    "source": "services/CortetsuSettingsNetwork.qml",
    "qmlId": "secretCopy",
    "startupPhase": "on-demand",
    "condition": "Tras copiar una contraseña; se marca sensible y vive 45 s o hasta la siguiente copia",
    "command": [
      "wl-copy",
      "--foreground",
      "--sensitive",
      "--type",
      "text/plain;charset=utf-8"
    ],
    "commandDisplay": "Secreto por stdin, sin historial",
    "manageable": false
  },
  {
    "id": "cortetsu:vpn-status",
    "name": "VPN status probe",
    "source": "base/services/VPN.qml",
    "qmlId": "statusProc",
    "startupPhase": "on-demand",
    "condition": "Al consultar el proveedor VPN seleccionado",
    "command": [],
    "commandSource": "root.active.statusCmd",
    "commandDisplay": "Comando de estado del proveedor VPN",
    "manageable": false
  },
  {
    "id": "cortetsu:brightness-discovery",
    "name": "Backlight device discovery",
    "source": "services/Brightness.qml",
    "qmlId": "discoverProcess",
    "startupPhase": "always-on",
    "condition": "Consulta de dispositivos al cargar el servicio de brillo y al cambiar las pantallas",
    "command": [
      "brightnessctl",
      "-l",
      "-m"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:brightness-connector",
    "name": "Backlight connector mapping",
    "source": "services/Brightness.qml",
    "qmlId": "connectorProcess",
    "startupPhase": "always-on",
    "condition": "Asocia cada retroiluminación a su conector al cargar el servicio de brillo y al cambiar las pantallas",
    "command": [
      "find",
      "/sys/class/backlight",
      "-mindepth",
      "1",
      "-maxdepth",
      "1",
      "-printf",
      "%f\t%l\n"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:brightness-read",
    "name": "Backlight level read-back",
    "source": "services/Brightness.qml",
    "qmlId": "readProcess",
    "startupPhase": "always-on",
    "condition": "Una lectura por pantalla con retroiluminación al cargar y después de cada cambio",
    "command": [
      "brightnessctl",
      "-d",
      "*",
      "g"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:nvibrant-status",
    "name": "NVIDIA vibrance capability",
    "source": "services/Nvibrant.qml",
    "qmlId": "statusProcess",
    "startupPhase": "on-demand",
    "condition": "Al abrir los controles de pantalla o cambiar los monitores; solo lee sysfs y el perfil",
    "command": [
      "cortetsu-nvibrant",
      "status"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:cpu-temperature",
    "name": "CPU temperature probe",
    "source": "services/Cpu.qml",
    "qmlId": "temperature",
    "startupPhase": "on-demand",
    "condition": "Cuando Dashboard o el bloqueo consulta recursos",
    "command": [
      "sh",
      "-c",
      "for f in /sys/class/thermal/thermal_zone*/temp; do [ -r \"$f\" ] && cat \"$f\" && break; done"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:gpu-probe",
    "name": "GPU telemetry probe",
    "source": "services/Gpu.qml",
    "qmlId": "probe",
    "startupPhase": "on-demand",
    "condition": "Mientras Dashboard está abierto; no despierta una dGPU suspendida",
    "command": [
      "cortetsu-hardware-probe",
      "--gpus"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:storage-probe",
    "name": "Storage usage probe",
    "source": "services/Storage.qml",
    "qmlId": "probe",
    "startupPhase": "on-demand",
    "condition": "Cuando Dashboard o el bloqueo consulta almacenamiento",
    "command": [
      "sh",
      "-c",
      "df -kP -x tmpfs -x devtmpfs 2>/dev/null"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:network-usage-probe",
