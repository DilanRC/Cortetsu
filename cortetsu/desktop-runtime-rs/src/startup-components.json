[
  {
    "id": "cortetsu:pomodoro",
    "name": "Pomodoro daemon",
    "source": "modules/pomodoro/Pomodoro.qml",
    "qmlId": "pomodoroOwner",
    "startupPhase": "always-on",
    "condition": "Se inicia con el shell; espera sin despertar hasta el fin de la fase",
    "command": [
      "cortetsu-pomodoro",
      "daemon"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:gamemode-control",
    "name": "Game mode state and control",
    "source": "services/GameMode.qml",
    "qmlId": "helper",
    "startupPhase": "conditional",
    "condition": "Al consultar el estado al cargar y al activar o desactivar el modo",
    "command": [
      "cortetsu-gamemode",
      "status"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:wallpaper-scan",
