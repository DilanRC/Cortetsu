    "source": "modules/CortetsuWallpapers.qml",
    "qmlId": "scan",
    "startupPhase": "conditional",
    "condition": "Al cargar el controlador de fondos, al cambiar el fondo y al abrir el gestor o el lanzador de fondos",
    "command": [
      "find",
      "*",
      "-type",
      "f"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:battery-notification",
    "name": "Battery notification helper",
    "source": "modules/BatteryMonitor.qml",
    "qmlId": null,
    "startupPhase": "conditional",
    "condition": "Al cruzar el umbral de batería baja o crítica",
    "command": [
      "notify-send",
      "--app-name=Cortetsu",
      "*",
      "*"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:battery-sleep",
    "name": "Critical battery sleep",
    "source": "modules/BatteryMonitor.qml",
    "qmlId": null,
    "startupPhase": "conditional",
    "condition": "Cinco segundos después de alcanzar 3% en batería; suspende si logind no admite hibernar",
    "command": [],
    "commandSource": "CortetsuSession.hibernate()",
    "commandDisplay": "systemctl hibernate o systemctl suspend, según logind",
    "manageable": false
  },
  {
    "id": "cortetsu:polkit-fallback",
    "name": "Fallback polkit agent",
    "source": "modules/PolkitHost.qml",
    "qmlId": null,
    "startupPhase": "conditional",
    "condition": "Si el agente polkit del shell no se registra en 5 segundos (otro agente ocupa la sesión o el registro falla)",
    "command": [
      "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
    ],
    "manageable": false
  },
  {
    "id": "cortetsu:spectrum",
    "name": "Cava visualizer",
    "source": "services/CortetsuSpectrum.qml",
