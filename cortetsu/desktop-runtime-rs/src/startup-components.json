  {
    "id": "cortetsu:session-sleep-capability",
    "name": "logind sleep capabilities",
    "source": "services/CortetsuSession.qml",
    "qmlId": null,
    "startupPhase": "always-on",
    "condition": "Al cargar, al abrir el menú de sesión y al reanudar; tres consultas D-Bus de solo lectura",
    "command": [
      "busctl",
      "call",
      "org.freedesktop.login1",
      "/org/freedesktop/login1",
      "org.freedesktop.login1.Manager",
      "Can*"
    ],
    "manageable": false
  },
