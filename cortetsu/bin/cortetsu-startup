def normalize_unit_state(state: str) -> dict[str, object]:
    """Keep systemd persistence, runtime scope, and manageability distinct."""
    if state in PERSISTENT_UNIT_STATES:
        category, label = "persistent", "Persistente"
    elif state in RUNTIME_UNIT_STATES:
        category, label = "runtime", "Temporal"
    elif state in DISABLED_UNIT_STATES:
        category, label = "disabled", "Deshabilitado"
    else:
        category, label = "special", "No administrable"
    return {
        "category": category,
        "label": label,
        "configured": category in {"persistent", "runtime"},
        "modifiable": state in TOGGLEABLE_UNIT_STATES,
        "persistent": category == "persistent",
        "runtime": category == "runtime",
    }


def activation_reason(unit: str, values: dict[str, str], file_state: str) -> tuple[str, str]:
    """Describe evidence, not inferred runtime causality."""
    triggered_by = [value for value in values.get("TriggeredBy", "").split() if value]
    if unit.endswith(".service") and triggered_by:
        activator = next((name for suffix in (".socket", ".timer", ".path")
                          for name in triggered_by if name.endswith(suffix)), None)
        if activator:
            kind = {".socket": "Puede activarse por socket", ".timer": "Programada por timer",
                    ".path": "Puede activarse por path"}[Path(activator).suffix]
            return f"{kind} {activator}; no se confirma que lo haya iniciado ahora.", "activator"
    targets = [*values.get("WantedBy", "").split(), *values.get("RequiredBy", "").split()]
    if targets and file_state in PERSISTENT_UNIT_STATES | RUNTIME_UNIT_STATES:
        scope = "durante esta sesión" if file_state in RUNTIME_UNIT_STATES else ""
        target = targets[0]
        return f"Instalada para iniciarse con {target}" + (f" {scope}" if scope else ""), "target"
    dependents = values.get("BoundBy", "").split()
    if unit.endswith(".service") and dependents:
        return (f"Puede iniciarse por dependencia de {dependents[0]}; "
                "la causalidad de esta ejecución no está confirmada."), "dependency"
    if values.get("ActiveState") == "active":
        return "Activa; inicio manual o activador exacto no determinado.", "unknown"
    return "Configurada mediante systemd --user. Activador exacto no determinado.", "unknown"


def process_argv_matches(command: list[str], argv: list[str], executable_path: Path,
                         running_executable_path: Path) -> bool:
    if not command or not argv:
        return False
    executable = Path(command[0]).name
    if Path(argv[0]).name == executable:
        actual_path = Path(shutil.which(argv[0]) or argv[0]) if "/" not in argv[0] else Path(argv[0])
        if (actual_path.resolve() != executable_path.resolve()
                or running_executable_path.resolve() != executable_path.resolve()):
            return False
        actual_args = argv[1:]
    elif (Path(argv[0]).name.startswith("python") and len(argv) > 1
          and Path(argv[1]).name == executable
          and Path(argv[1]).resolve() == executable_path.resolve()
          and Path(shutil.which(argv[0]) or argv[0]).resolve() == running_executable_path.resolve()):
        # A shebang script appears as python + script path in /proc/<pid>/cmdline.
        actual_args = argv[2:]
    else:
        return False
    return (len(actual_args) >= len(command[1:])
            and all(fnmatch.fnmatchcase(actual, expected)
                    for actual, expected in zip(actual_args, command[1:])))


def process_is_running(command: list[str], proc_root: Path = Path("/proc"),
                       unambiguous: bool = True, executable_path: Path | None = None) -> bool | None:
    """Report state only for a unique Cortetsu executable command signature."""
    if (not unambiguous or not command
            or not Path(command[0]).name.startswith("cortetsu-")):
        # Generic executables and duplicate Cortetsu commands cannot identify one producer.
        return None
    executable_path = executable_path or Path(shutil.which(command[0]) or command[0])
    for proc in proc_root.glob("[0-9]*"):
        if proc.name == str(os.getpid()):
            continue
        try:
            argv = [part.decode(errors="replace") for part in (proc / "cmdline").read_bytes().split(b"\0") if part]
            running_executable_path = (proc / "exe").resolve(strict=True)
        except OSError:
            continue
        if process_argv_matches(command, argv, executable_path, running_executable_path):
            return True
    return False


def cortetsu_source_root() -> Path:
    candidates = [
        Path(__file__).resolve().parents[1],
        Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "cortetsu/repository/cortetsu",
        config_home() / "quickshell/cortetsu/current",
    ]
    return next((path for path in candidates if (path / "modules").is_dir()), candidates[-1])


def cortetsu_entries() -> list[dict]:
    result = []
    source_root = cortetsu_source_root()
    executable_counts = Counter(
        Path(component["command"][0]).name for component in CORTETSU_STARTUP
        if component["command"] and Path(component["command"][0]).name.startswith("cortetsu-")
    )
    for component in CORTETSU_STARTUP:
        source = source_root / component["source"]
        command = component["command"]
        executable = Path(command[0]).name if command else ""
        result.append({
            "id": component["id"], "name": component["name"], "icon": "deployed_code",
            "description": component["condition"], "sourceType": "cortetsu",
            "origin": str(source),
            "command": component.get("commandDisplay", shlex.join(component["command"])),
            "startupPhase": component["startupPhase"],
            "startupState": component["startupPhase"],
            "startupLabel": {"always-on": "Siempre activo", "conditional": "Condicional",
                             "on-demand": "Bajo demanda"}[component["startupPhase"]],
            "configured": component["startupPhase"] != "on-demand",
            "running": process_is_running(
                command, unambiguous=executable_counts[executable] == 1,
                executable_path=Path(shutil.which(command[0]) or command[0]) if command else None,
            )
            if command else None,
            "modifiable": False,
            "reason": component["condition"],
        })
    return result


def run(args: list[str], timeout: float = 4) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def systemd_command(exec_start: str) -> str:
    commands = []
    for match in re.finditer(r"argv\[\]=([^;]+)", exec_start):
        try:
            commands.append(shlex.join(shlex.split(match.group(1).strip())))
        except ValueError:
            continue
    return "\n".join(commands)


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def desktop_entry(path: Path, system: bool, current_desktops: set[str]) -> dict | None:
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    try:
        parser.read(path, encoding="utf-8")
        entry = parser["Desktop Entry"]
    except (OSError, KeyError, configparser.Error):
        return None
    hidden = entry.get("Hidden", "false").lower() == "true"
    only = set(filter(None, entry.get("OnlyShowIn", "").split(";")))
    not_show = set(filter(None, entry.get("NotShowIn", "").split(";")))
    try_exec = entry.get("TryExec", "").strip()
    try_ok = not try_exec or shutil.which(try_exec) is not None or (
        Path(try_exec).is_absolute() and os.access(try_exec, os.X_OK)
    )
    eligible = (not only or bool(only & current_desktops)) and not bool(not_show & current_desktops) and try_ok
    return {
        "id": "xdg:" + path.name,
        "name": entry.get("Name", path.stem),
        "icon": entry.get("Icon", ""),
        "description": entry.get("Comment", ""),
        "sourceType": "xdg-user" if not system else "xdg-system",
        "origin": str(path),
        "command": entry.get("Exec", ""),
        "startupPhase": "login",
        "configured": not hidden,
        "eligible": eligible,
        "running": None,
        "modifiable": True,
        "reason": ("Entrada efectiva de inicio de sesión" if not hidden and eligible else
                   "Configurada, pero no aplicable en este escritorio o TryExec no disponible" if not hidden else "Deshabilitada mediante Hidden=true"),
        "_path": str(path),
        "_system": system,
    }


def xdg_entries() -> list[dict]:
    user_dir = config_home() / "autostart"
    config_dirs = os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":")
    system_dirs = [Path(value) / "autostart" for value in config_dirs if value]
    desktops = set(filter(None, os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")))
    by_name: dict[str, tuple[Path, bool]] = {}
    for directory, is_system in [(d, True) for d in reversed(system_dirs)] + [(user_dir, False)]:
        try:
            paths = sorted(directory.glob("*.desktop"))
        except OSError:
            continue
        for path in paths:
            by_name[path.name] = (path, is_system)
    result = []
    for path, system in by_name.values():
        item = desktop_entry(path, system, desktops)
        if item:
            result.append(item)
    return result


def systemd_entries(user: bool) -> list[dict]:
    prefix = ["systemctl"] + (["--user"] if user else [])
    listing = run(prefix + ["list-unit-files", "--type=service", "--type=socket", "--type=timer", "--type=path", "--no-legend", "--no-pager"])
    unit_lines = listing.stdout.splitlines() if listing and listing.returncode == 0 else []
    units_by_name = {fields[0]: fields[1] for line in unit_lines
                     if len(fields := line.split()) >= 2 and UNIT_RE.fullmatch(fields[0])}
    active_units = run(prefix + ["list-units", "--all", "--type=service", "--type=socket", "--type=timer", "--type=path", "--no-legend", "--no-pager"])
    if active_units and active_units.returncode == 0:
        for line in active_units.stdout.splitlines():
            fields = line.split(None, 4)
            if len(fields) >= 4 and UNIT_RE.fullmatch(fields[0]) and fields[0] not in units_by_name:
                units_by_name[fields[0]] = "transient"
    units = list(units_by_name.items())
    snapshots: dict[str, dict[str, str]] = {}
    for offset in range(0, len(units), 80):
        names = [unit for unit, _ in units[offset:offset + 80]]
        props = run(prefix + ["show", *names, "--property=Id,Description,ActiveState,UnitFileState,WantedBy,RequiredBy,TriggeredBy,BoundBy,ConsistsOf,FragmentPath,ExecStart"])
        for block in (props.stdout if props else "").split("\n\n"):
            values = dict(part.split("=", 1) for part in block.splitlines() if "=" in part)
            if values.get("Id"):
                snapshots[values["Id"]] = values
    result = []
    for unit, file_state in units:
        values = snapshots.get(unit, {})
        active = values.get("ActiveState", "unknown")
        state = normalize_unit_state(file_state)
        source_type = "cortetsu" if user and unit.startswith("cortetsu-") else ("systemd-user" if user else "systemd-system")
        modifiable = user and source_type == "systemd-user" and bool(state["modifiable"])
        reason, activation_type = activation_reason(unit, values, file_state) if user else (
            "Configurada mediante systemd del sistema. Activador exacto no determinado.", "unknown")
        if unit == "cortetsu-shell.service":
            reason += " · Servicio principal de Cortetsu; esta página no permite desactivarlo"
        result.append({
            "id": ("user-unit:" if user else "system-unit:") + unit,
            "name": values.get("Description") or unit,
            "icon": "settings_suggest",
            "description": unit,
            "sourceType": source_type,
            "origin": values.get("FragmentPath", unit),
            "command": systemd_command(values.get("ExecStart", "")),
            "startupPhase": "login" if user else "boot",
            "configured": state["configured"],
            "startupState": state["category"],
            "startupLabel": state["label"],
            "persistent": state["persistent"],
            "runtimeOnly": state["runtime"],
            "running": active == "active" if active in {"active", "inactive", "failed"} else None,
            "activeState": active,
            "unitState": file_state,
            "activationType": activation_type,
            "target": ", ".join(filter(None, (values.get("WantedBy", "").split(" ") + values.get("RequiredBy", "").split(" ")))),
            "modifiable": modifiable,
            "reason": reason,
            "_unit": unit,
            "_user": user,
            "_exec_start": values.get("ExecStart", ""),
            "_file_state": file_state,
        })
    return result


def hyprland_sources() -> list[Path]:
    root = config_home() / "hypr/hyprland.lua"
    if not root.is_file():
        return []
    sources: set[Path] = {root}
    try:
        wrapper = root.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return [root]
    target = re.search(r'dofile\(\s*["\']([^"\']+)["\']\s*\)', wrapper)
    active = Path(target.group(1)).expanduser() if target else root
    if active.is_file():
        sources.add(active)
        try:
            text = active.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        module_block = re.search(r"local required_modules\s*=\s*\{(.*?)\}", text, re.S)
        if module_block:
            for module in re.findall(r'["\']([A-Za-z0-9_.-]+)["\']', module_block.group(1)):
                candidate = active.parent / (module.replace(".", "/") + ".lua")
                if candidate.is_file():
                    sources.add(candidate)
        custom_block = re.search(r"for _, name in ipairs\(\{(.*?)\}\)", text, re.S)
        if custom_block:
            for name in re.findall(r'["\']([A-Za-z0-9_.-]+)["\']', custom_block.group(1)):
                candidate = config_home() / f"hypr/custom/{name}.lua"
                if candidate.is_file():
                    sources.add(candidate)
        user_file = config_home() / "hypr/hypr-user.lua"
        if user_file.is_file():
            sources.add(user_file)
    return sorted(sources)


def scan() -> list[dict]:
    entries = xdg_entries() + systemd_entries(True) + systemd_entries(False)
    # Read only source files referenced by the active Lua loader; never evaluate Lua.
    for path in hyprland_sources():
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        in_start = False
        for number, line in enumerate(lines, 1):
            if re.search(r'hl\.on\(\s*["\']hyprland\.start["\']', line):
                in_start = True
            elif in_start and re.match(r"^end\s*\)\s*$", line):
                in_start = False
            elif in_start and re.match(r"^\s+hl\.exec_cmd\(", line):
                command_match = re.search(r'hl\.exec_cmd\(\s*(?:"((?:\\.|[^"\\])*)"|\'((?:\\.|[^\'\\])*)\'|\[\[(.*?)\]\])', line)
                command = next((value for value in command_match.groups() if value is not None), "") if command_match else ""
                entries.append({"id": f"hyprland:{path}:{number}", "name": "Hyprland startup command",
                    "icon": "terminal", "description": "", "sourceType": "hyprland", "origin": f"{path}:{number}",
                    "command": command or line.strip(), "startupPhase": "shell", "configured": True, "running": None,
                    "modifiable": False, "reason": "Hyprland ejecuta esta entrada al iniciar la sesión"})
    entries.extend(cortetsu_entries())
    unit_commands = user_unit_command_lookup(entries)
    parents = list(range(len(entries)))

    def find(index: int) -> int:
        if parents[index] != index:
            parents[index] = find(parents[index])
        return parents[index]

    def union(left: int, right: int) -> None:
        left_root, right_root = find(left), find(right)
        if left_root != right_root:
            parents[right_root] = left_root

    owners: dict[str, int] = {}
    for index, item in enumerate(entries):
        keys = duplicate_keys(item, unit_commands)
        item["_duplicate_keys"] = keys
        for key in keys:
            if key in owners:
                union(index, owners[key])
            else:
                owners[key] = index
    counts: dict[int, int] = {}
    for index, item in enumerate(entries):
        if item["_duplicate_keys"]:
            group = find(index)
            counts[group] = counts.get(group, 0) + 1
    for index, item in enumerate(entries):
        keys = item.pop("_duplicate_keys", [])
        item["duplicateCount"] = counts.get(find(index), 0) if keys else 0
        item.pop("_path", None); item.pop("_system", None); item.pop("_unit", None); item.pop("_user", None); item.pop("_exec_start", None); item.pop("_file_state", None)
    return entries


def user_unit_command_lookup(entries: list[dict]) -> dict[str, list[str]]:
    return {
        item["_unit"]: [key for command in item.get("command", "").splitlines() if (key := command_key(command))]
        for item in entries if item.get("_user") is True and item.get("_unit")
    }


def command_key(raw: str) -> str:
    try:
        argv = shlex.split(raw)
    except ValueError:
        return ""
    if not argv or any("%" in value for value in argv):
        return ""
    executable = argv[0]
    resolved = shutil.which(executable) if not os.path.isabs(executable) else executable
    argv[0] = os.path.abspath(resolved) if resolved else executable
    return "command:" + json.dumps(argv, ensure_ascii=False, separators=(",", ":"))


def duplicate_keys(item: dict, unit_commands: dict[str, list[str]] | None = None) -> list[str]:
    source = item.get("sourceType")
    if source in {"systemd-user", "cortetsu"} and item.get("_unit"):
        if not item.get("configured"):
            return []
        unit = item.get("_unit", "")
        keys = [f"unit:{unit}"] if unit and item.get("_file_state") != "alias" else []
        for command in item.get("command", "").splitlines():
            key = command_key(command)
            if key:
                keys.append(key)
        return list(dict.fromkeys(keys))
    if source not in {"xdg-user", "xdg-system", "hyprland", "cortetsu"}:
        return []
    if source.startswith("xdg-") and (not item.get("configured") or item.get("eligible") is False):
        return []
    raw = item.get("command", "")
    if source == "hyprland" and raw.startswith("hl.exec_cmd("):
        return []
    try:
        argv = shlex.split(raw)
    except ValueError:
        return []
    if argv and argv[0] == "systemctl" and "--user" in argv:
        unit = next((value for value in argv if UNIT_RE.fullmatch(value)), "")
        return ([f"unit:{unit}"] + (unit_commands or {}).get(unit, [])) if unit else []
    key = command_key(raw)
    return [key] if key else []


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temp_name, mode)
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def set_hidden(path: Path, hidden: bool) -> None:
    old = path.read_bytes()
    state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "cortetsu/startup/backups"
    state_dir.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    state_dir.parent.chmod(0o700)
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    state_dir.chmod(0o700)
    digest = hashlib.sha256(old).hexdigest()
    backup = state_dir / f"{digest}.desktop"
    if not backup.exists():
        atomic_write(backup, old, 0o600)
    text = old.decode("utf-8", "replace")
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if line.strip() == "[Desktop Entry]"), None)
    if start is None:
        raise ValueError("falta [Desktop Entry]")
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    positions = [i for i in range(start + 1, end) if lines[i].startswith("Hidden=")]
    value = f"Hidden={'true' if hidden else 'false'}"
    if positions:
        lines[positions[0]] = value
        for i in reversed(positions[1:]):
            del lines[i]
    else:
        lines.insert(end, value)
    atomic_write(path, ("\n".join(lines).rstrip("\n") + "\n").encode(), path.stat().st_mode & 0o777)


def action(item_id: str, desired: str) -> dict:
    if desired not in {"enable", "disable", "stop"}:
        raise ValueError("acción inválida")
    found = next((item for item in scan() if item["id"] == item_id), None)
    if not found or not found.get("modifiable"):
        raise ValueError("esta entrada no se puede modificar")
    if desired == "stop":
        if not item_id.startswith("user-unit:") or not found.get("running"):
            raise ValueError("sólo se pueden detener unidades de usuario activas")
        unit = item_id[len("user-unit:"):]
        if not UNIT_RE.fullmatch(unit):
            raise ValueError("unidad inválida")
        cp = run(["systemctl", "--user", "stop", unit])
        if not cp or cp.returncode:
            raise RuntimeError((cp.stderr.strip() if cp else "systemctl no disponible") or "systemctl falló")
        updated = next((item for item in scan() if item["id"] == item_id), None)
        if not updated or updated["running"] is not False:
            raise RuntimeError("la verificación posterior no confirmó que la unidad se detuviera")
        record_change(found["sourceType"], found["name"], "running", "stopped", "stop")
        return {"ok": True, "entry": updated}
    if item_id.startswith("xdg:"):
        filename = item_id[4:]
        if Path(filename).name != filename or not filename.endswith(".desktop"):
            raise ValueError("identificador de archivo inválido")
        target = config_home() / "autostart" / filename
        target_dir = target.parent
        if target_dir.is_symlink() or (target.exists() and target.is_symlink()):
            raise ValueError("no se modifican enlaces simbólicos de autostart")
        if target.resolve(strict=False).parent != target_dir.resolve(strict=False):
            raise ValueError("ruta de autostart fuera del directorio del usuario")
        if not target.exists():
            source = Path(found["origin"])
            if source.resolve().parent not in [Path(d).resolve() / "autostart" for d in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") if Path(d).exists()]:
                raise ValueError("origen XDG fuera de los directorios permitidos")
            atomic_write(target, source.read_bytes(), 0o600)
        set_hidden(target, desired == "disable")
    elif item_id.startswith("user-unit:"):
        unit = item_id[len("user-unit:"):]
        if not UNIT_RE.fullmatch(unit) or unit == "cortetsu-shell.service":
            raise ValueError("unidad no administrable")
        cp = run(["systemctl", "--user", desired, unit])
        if not cp or cp.returncode:
            raise RuntimeError((cp.stderr.strip() if cp else "systemctl no disponible") or "systemctl falló")
    else:
        raise ValueError("origen no administrable")
    updated = next((item for item in scan() if item["id"] == item_id), None)
    expected = desired == "enable"
    if not updated or updated["configured"] != expected:
        raise RuntimeError("la verificación posterior no confirmó el cambio")
    record_change(found["sourceType"], found["name"], found["configured"], expected, desired)
    return {"ok": True, "entry": updated}


def record_change(source: str, name: str, old_state: bool | str, new_state: bool | str, action: str) -> None:
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "cortetsu/startup/changes.jsonl"
    state.parent.mkdir(parents=True, exist_ok=True)
    state.parent.chmod(0o700)
    descriptor = os.open(state, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(descriptor, "a", encoding="utf-8") as stream:
        stream.write(json.dumps({"timestamp": int(time.time()), "source": source, "item": name, "oldState": old_state, "newState": new_state, "action": action}) + "\n")


def main(argv: list[str]) -> int:
    try:
        if argv == ["scan"]:
            print(json.dumps({"ok": True, "entries": scan()}))
        elif len(argv) == 3 and argv[0] == "set":
            print(json.dumps(action(argv[1], argv[2])))
        else:
            print(json.dumps({"ok": False, "error": "uso: cortetsu-startup scan | set ID enable|disable|stop"}))
            return 2
    except (ValueError, RuntimeError, OSError) as error:
        print(json.dumps({"ok": False, "error": str(error)}))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
