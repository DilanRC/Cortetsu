UNIT_RE = re.compile(r"^[A-Za-z0-9_.@:-]+\.(service|socket|timer|path)$")
PERSISTENT_UNIT_STATES = {"enabled", "linked"}
RUNTIME_UNIT_STATES = {"enabled-runtime", "linked-runtime"}
DISABLED_UNIT_STATES = {"disabled"}
TOGGLEABLE_UNIT_STATES = PERSISTENT_UNIT_STATES | RUNTIME_UNIT_STATES | DISABLED_UNIT_STATES

