#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

UID = os.getuid()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{UID}"))
CONFIG_PATH = Path.home() / ".config/cortetsu/power-auto.json"
STATE_PATH = RUNTIME / "cortetsu-power-auto-state.json"
EVENTS_PATH = Path.home() / ".local/state/cortetsu/power-auto-events.jsonl"

DEFAULTS = {
    "enabled": False,
    "ac_profile": "performance",
    "battery_profile": "balanced",
    "low_battery_enabled": True,
    "low_battery_threshold": 25,
    "low_battery_profile": "power-saver",
    "poll_seconds": 4,
}
VALID_PROFILES = {"power-saver", "balanced", "performance"}
MAX_EVENTS = 200


def read_text(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return default


def load_json(path: Path, default):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, type(default)) else default
    except (OSError, json.JSONDecodeError):
        return default


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    parsed = load_json(CONFIG_PATH, {})
    cfg.update(parsed)
    for key in ("ac_profile", "battery_profile", "low_battery_profile"):
        if cfg.get(key) not in VALID_PROFILES:
            cfg[key] = DEFAULTS[key]
    cfg["enabled"] = bool(cfg.get("enabled", False))
    cfg["low_battery_enabled"] = bool(cfg.get("low_battery_enabled", True))
    try:
        cfg["low_battery_threshold"] = max(5, min(80, int(cfg.get("low_battery_threshold", 25))))
    except (TypeError, ValueError):
        cfg["low_battery_threshold"] = 25
    try:
        cfg["poll_seconds"] = max(2, min(30, int(cfg.get("poll_seconds", 4))))
    except (TypeError, ValueError):
        cfg["poll_seconds"] = 4
    return cfg


def read_state() -> dict:
    return load_json(STATE_PATH, {})


def write_state(payload: dict) -> None:
    payload = {"timestamp": int(time.time()), **payload}
    try:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps(payload, separators=(",", ":")), encoding="utf-8")
        tmp.replace(STATE_PATH)
    except OSError:
        pass


def append_event(payload: dict) -> None:
    event = {"timestamp": int(time.time()), **payload}
    try:
        EVENTS_PATH.parent.mkdir(parents=True, exist_ok=True)
        lines = []
        if EVENTS_PATH.exists():
            lines = EVENTS_PATH.read_text(encoding="utf-8", errors="replace").splitlines()[-(MAX_EVENTS - 1):]
        lines.append(json.dumps(event, separators=(",", ":")))
        tmp = EVENTS_PATH.with_suffix(".tmp")
        tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
        tmp.replace(EVENTS_PATH)
    except OSError:
        pass


def power_source() -> tuple[bool, float | None, str]:
    ac_online = False
    for supply in Path("/sys/class/power_supply").glob("*"):
        supply_type = read_text(supply / "type")
        if supply_type in {"Mains", "USB", "USB_C", "USB_PD"} and read_text(supply / "online", "0") == "1":
            ac_online = True
            break

    percent = None
    status = ""
    batteries = sorted(Path("/sys/class/power_supply").glob("BAT*"))
    if batteries:
        try:
            percent = float(read_text(batteries[0] / "capacity"))
        except ValueError:
            percent = None
        status = read_text(batteries[0] / "status")
    return ac_online, percent, status


def desired_profile(cfg: dict, ac_online: bool, percent: float | None) -> tuple[str, str]:
    if ac_online:
        return cfg["ac_profile"], "AC connected"
    if cfg.get("low_battery_enabled", True) and percent is not None and percent <= cfg["low_battery_threshold"]:
        return cfg["low_battery_profile"], f"battery <= {cfg['low_battery_threshold']}%"
    return cfg["battery_profile"], "on battery"


def get_current(exe: str) -> str:
    try:
        cp = subprocess.run([exe, "get"], text=True, capture_output=True, timeout=3, check=False)
        return cp.stdout.strip() if cp.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def apply_profile(exe: str, profile: str) -> tuple[bool, str]:
    try:
        cp = subprocess.run([exe, "set", profile], text=True, capture_output=True, timeout=8, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    if cp.returncode != 0:
        return False, (cp.stderr or cp.stdout).strip()
    return True, ""


def iteration(force: bool = False, settled: str = "") -> tuple[bool, str]:
    """Run one pass; return (keep_running, settled).

    settled is the profile this watcher last verified for the current rule.
    While the rule still asks for it nothing is spawned, so a profile the user
    picks by hand stays until the next AC/battery transition or config change.
    """
    cfg = load_config()
    previous = read_state()

    if not cfg.get("enabled", False) and not force:
        write_state({"enabled": False, "active": False, "reason": "automation disabled"})
        return False, ""

    exe = shutil.which("powerprofilesctl")
    if not exe:
        state = {
            "enabled": cfg.get("enabled", False),
            "active": False,
            "one_shot": force,
            "ok": False,
            "error": "powerprofilesctl not found",
        }
        write_state(state)
        append_event({"kind": "error", **state})
        return cfg.get("enabled", False) and not force, ""

    ac_online, percent, battery_status = power_source()
    desired, reason = desired_profile(cfg, ac_online, percent)
    if not force and desired == settled:
        write_state({**previous, "ac_online": ac_online, "battery_percent": percent,
                     "battery_status": battery_status, "reason": reason})
        return bool(cfg.get("enabled", False)), settled
    before = get_current(exe)
    requested_change = bool(before and before != desired)
    ok = True
    error = ""

    if requested_change:
        ok, error = apply_profile(exe, desired)

    after = get_current(exe) if requested_change else before
    verified = bool(after == desired) if desired else False
    if requested_change and ok and not verified:
        ok = False
        error = f"profile verification failed: expected {desired}, got {after or 'unknown'}"

    state = {
        "enabled": cfg.get("enabled", False),
        "active": bool(cfg.get("enabled", False) and not force),
        "one_shot": force,
        "ac_online": ac_online,
        "battery_percent": percent,
        "battery_status": battery_status,
        "desired_profile": desired,
        "previous_profile": before,
        "profile": after or before,
        "reason": reason,
        "changed": requested_change and verified,
        "ok": ok,
        "error": error,
    }
    write_state(state)

    source_changed = previous.get("ac_online") is not None and previous.get("ac_online") != ac_online
    desired_changed = previous.get("desired_profile") and previous.get("desired_profile") != desired
    profile_changed = before != (after or before)
    if force or source_changed or desired_changed or profile_changed or not ok:
        append_event({
            "kind": "apply" if ok else "error",
            "source": "ac" if ac_online else "battery",
            "battery_percent": percent,
            "desired_profile": desired,
            "previous_profile": before,
            "profile": after or before,
            "reason": reason,
            "changed": requested_change and verified,
            "one_shot": force,
            "ok": ok,
            "error": error,
        })

    return bool(cfg.get("enabled", False) and not force), (after or before) if ok and (after or before) == desired else ""


def main() -> int:
    once = "--once" in sys.argv
    if once:
        iteration(force=True)
        return 0

    settled = ""
    while True:
        keep_running, settled = iteration(force=False, settled=settled)
        if not keep_running:
            return 0
        time.sleep(load_config().get("poll_seconds", 4))


if __name__ == "__main__":
    raise SystemExit(main())
