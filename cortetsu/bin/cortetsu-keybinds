#!/usr/bin/env python3
"""Read and edit Cortetsu's Hyprland keybinds without touching managed files.

The defaults (variables.lua, hyprland/keybinds.lua) and the user layer
(hypr-user.lua) belong to the promoted dotfiles generation and are read-only
here. Edits live in ~/.config/cortetsu/keybinds.json; the helper compiles them
into ~/.config/hypr/cortetsu-keybinds.lua, plain data that hyprland.lua
applies on every load (variables before the first-party modules; removed and
added binds after hypr-user.lua). Every change is a transaction: snapshot,
atomic write, luac check, reload, then a check of `hyprctl binds -j` by bind
description, rolling back if Hyprland does not show the expected result.

  list                              JSON with every bind and its state
  set ID CHORD                      rebind
  delete ID                         remove
  reset ID                          drop the edit and go back to the layer below
  add-app APP_ID NAME COMMAND CHORD launch an application
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
from datetime import datetime
from pathlib import Path
from typing import NamedTuple

HOME = Path.home()
HYPR = HOME / ".config/hypr"
DEFAULTS = HYPR / "variables.lua"
FIRST_PARTY = HYPR / "hyprland/keybinds.lua"
USER = HYPR / "hypr-user.lua"
STORE = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "cortetsu/keybinds.json"
COMPILED = HYPR / "cortetsu-keybinds.lua"
SNAPSHOTS = HOME / ".local/share/cortetsu/snapshots/keybinds"
HYPRCTL = os.environ.get("CORTETSU_HYPRCTL", "hyprctl")
LUAC = shutil.which("luac") or shutil.which("luac5.4")

ENTRY_RE = re.compile(r"(?m)^(\s*)([A-Za-z_][A-Za-z0-9_]*)(\s*=\s*)(\{[^\n]*\}|\"(?:\\.|[^\"])*\")(,?)")
STRING_RE = re.compile(r'\"((?:\\.|[^\"])*)\"')
APP_COMMENT_RE = re.compile(r"(?m)^-- Cortetsu app shortcut: (.*?) \((.*?)\)\s*$")
LITERAL_BIND_RE = re.compile(r'create_bind\(\s*(\{[^}]*\}|"(?:\\.|[^"])*")\s*,\s*([^\n]*)')
MOD_BITS = {"SHIFT": 1, "CAPS": 2, "CTRL": 4, "CONTROL": 4, "ALT": 8, "MOD2": 16, "MOD3": 32,
            "SUPER": 64, "WIN": 64, "MOD4": 64, "MOD5": 128}
MODIFIERS = {"SHIFT", "CTRL", "CONTROL", "ALT", "SUPER", "WIN", "MOD4"}
APP_COMMANDS = {
    "kbTerminal": "terminal",
    "kbBrowser": "browser",
    "kbEditor": "editor",
    "kbFileExplorer": "fileExplorer",
    "kbAudioSettings": "audioSettings",
}
APP_QUERIES = {"kbTerminal": "kitty"}
KEY_NAME_RE = re.compile(r"^(?:[A-Za-z0-9]|F(?:[1-9]|1[0-9]|2[0-4])|KP_[A-Za-z0-9_]+|XF86[A-Za-z0-9]+|code:\d+|"
                         r"Return|Space|Tab|Backspace|Delete|Insert|Home|End|Page_Up|Page_Down|Left|Right|Up|Down|"
                         r"Print|Pause|Escape|Comma|Period|Slash|Backslash|Minus|Equal|Semicolon|Apostrophe|Grave|"
                         r"BracketLeft|BracketRight|Menu|SUPER_L|SUPER_R|mouse:\d+|mouse_up|mouse_down)$", re.I)
# Keys that are pressed alone by design: dedicated hardware and spare F-keys.
SOLO_KEY_RE = re.compile(r"^(?:XF86[A-Za-z0-9]+|Print|F(?:1[3-9]|2[0-4]))$", re.I)


class KeybindError(RuntimeError):
    pass


class BindBlock(NamedTuple):
    start: int
    end: int
    chord: str
    body: str


def binding_blocks(text: str) -> list[BindBlock]:
    """`hl.bind("CHORD", BODY)` calls, skipping comments and long strings."""
    blocks = []
    cursor = 0
    marker = "hl.bind("
    while (start := text.find(marker, cursor)) >= 0:
        index = start + len(marker)
        depth = 1
        quote = ""
        long_close = ""
        line_comment = False
        close = -1
        while index < len(text):
            char = text[index]
            if line_comment:
                line_comment = char != "\n"
                index += 1
                continue
            if long_close:
                if text.startswith(long_close, index):
                    index += len(long_close)
                    long_close = ""
                else:
                    index += 1
                continue
            if quote:
                if char == "\\":
                    index += 2
                    continue
                if char == quote:
                    quote = ""
                index += 1
                continue
            if text.startswith("--", index):
                long_match = re.match(r"--\[(=*)\[", text[index:])
                if long_match:
                    long_close = "]" + long_match.group(1) + "]"
                    index += long_match.end()
                else:
                    line_comment = True
                    index += 2
                continue
            long_match = re.match(r"\[(=*)\[", text[index:])
            if long_match:
                long_close = "]" + long_match.group(1) + "]"
                index += long_match.end()
                continue
            if char in "\"'":
                quote = char
            elif char == "(":
                depth += 1
            elif char == ")":
                depth -= 1
                if depth == 0:
                    close = index
                    break
            index += 1
        if close < 0:
            cursor = start + len(marker)
            continue
        chord_quote = start + len(marker)
        while chord_quote < close and text[chord_quote].isspace():
            chord_quote += 1
        if chord_quote >= close or text[chord_quote] != '"':
            cursor = close + 1
            continue
        chord_end = chord_quote + 1
        while chord_end < close:
            if text[chord_end] == "\\":
                chord_end += 2
                continue
            if text[chord_end] == '"':
                break
            chord_end += 1
        comma = chord_end + 1
        while comma < close and text[comma].isspace():
            comma += 1
        if chord_end >= close or comma >= close or text[comma] != ",":
            cursor = close + 1
            continue
        blocks.append(BindBlock(start=start, end=close + 1, chord=lua_unescape(text[chord_quote + 1:chord_end]),
                                body=text[comma + 1:close].strip()))
        cursor = close + 1
    return blocks


LUA_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", '"': '"', "'": "'"}


def lua_unescape(value: str) -> str:
    """Lua string escapes only; every other character, ñ included, stays as is."""
    return re.sub(r"\\(.)", lambda match: LUA_ESCAPES.get(match.group(1), match.group(1)), value)


def lua_quote(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r")
    return '"' + escaped + '"'


def values(rhs: str) -> list[str]:
    return [lua_unescape(item) for item in STRING_RE.findall(rhs)]


def entries(path: Path) -> dict[str, list[str]]:
    # Drop comments so a commented-out kb* line is not read as a bind.
    text = re.sub(r"--[^\n]*", "", path.read_text(encoding="utf-8"))
    return {match.group(2): values(match.group(4)) for match in ENTRY_RE.finditer(text)}


def title(name: str) -> str:
    words = re.sub(r"([a-z])([A-Z])", r"\1 \2", name.removeprefix("kb"))
    return words.replace("Ws", "workspace").strip().title()


def digest(*parts: str) -> str:
    return hashlib.sha256("\0".join(parts).encode()).hexdigest()[:16]


def normalise(chord: str) -> str:
    parts = [part.strip().upper() for part in chord.split("+") if part.strip()]
    mods = sorted({"CTRL" if part == "CONTROL" else "SUPER" if part in ("WIN", "MOD4") else part
                   for part in parts[:-1]})
    return "+".join(mods + parts[-1:])


def chord_parts(chord: str) -> tuple[int, str]:
    parts = [part.strip() for part in chord.split("+") if part.strip()]
    if not parts:
        return 0, ""
    modmask = 0
    for modifier in parts[:-1]:
        modmask |= MOD_BITS.get(modifier.upper(), 0)
    return modmask, parts[-1].upper()


def only_modifiers(chord: str) -> bool:
    return all(part.strip().upper() in MODIFIERS for part in chord.split("+") if part.strip())


def validate_chord(chord: str) -> str:
    """The chord as stored, or an error a person can act on."""
    parts = [part.strip() for part in chord.split("+") if part.strip()]
    if not parts:
        raise KeybindError("Hace falta una combinación de teclas")
    *mods, key = parts
    for modifier in mods:
        if modifier.upper() in ("MOD5", "ALTGR", "ISO_LEVEL3_SHIFT"):
            raise KeybindError("AltGr escribe caracteres en la distribución latam; no se puede usar en atajos")
        if modifier.upper() not in MODIFIERS:
            raise KeybindError(f"{modifier} no es un modificador (Super, Ctrl, Alt o Shift)")
    if key.upper() in MODIFIERS or not KEY_NAME_RE.match(key):
        raise KeybindError(f"{key} no es una tecla que Hyprland reconozca")
    upper = {modifier.upper() for modifier in mods}
    if not mods and not SOLO_KEY_RE.match(key):
        raise KeybindError("Una tecla sola interceptaría la escritura; añade Super")
    if mods and not upper & {"SUPER", "WIN", "MOD4"} and not SOLO_KEY_RE.match(key) and not {"CTRL", "ALT"} <= upper:
        # CTRL + End, CTRL + Down: the navigation the old app shortcuts stole.
        raise KeybindError("Sin Super la combinación pertenece a las aplicaciones; usa Super o Ctrl + Alt")
    return " + ".join([*(modifier.upper() for modifier in mods), key])


# --- the edit store -------------------------------------------------------

def refuse_symlink(path: Path) -> None:
    if path.is_symlink():
        raise KeybindError(f"{path} es un enlace a otro archivo; no se reemplaza")


def load_store() -> dict:
    try:
        data = json.loads(STORE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        data = {}
    except ValueError as error:
        raise KeybindError(f"{STORE} no es JSON válido: {error}") from None
    store = {"schema": 1, "variables": {}, "unbind": [], "binds": []}
    if isinstance(data, dict):
        store["variables"] = {str(name): [str(chord) for chord in chords]
                              for name, chords in (data.get("variables") or {}).items()
                              if str(name).startswith("kb") and isinstance(chords, list)}
        store["unbind"] = [str(chord) for chord in data.get("unbind") or [] if isinstance(chord, str)]
        store["binds"] = [bind for bind in data.get("binds") or []
                          if isinstance(bind, dict) and isinstance(bind.get("id"), str)
                          and isinstance(bind.get("chord"), str)
                          and (isinstance(bind.get("exec"), str) or isinstance(bind.get("global"), str))]
    return store


def compile_store(store: dict) -> str:
    lines = ["-- Generated by cortetsu-keybinds from ~/.config/cortetsu/keybinds.json. Do not edit.",
             "return {", "    variables = {"]
    for name in sorted(store["variables"]):
        if not re.fullmatch(r"kb[A-Za-z0-9_]+", name):
            raise KeybindError(f"Nombre de variable no válido: {name}")
        chords = ", ".join(lua_quote(chord) for chord in store["variables"][name])
        lines.append(f"        {name} = {{ {chords} }},")
    lines += ["    },", "    unbind = {"]
    lines += [f"        {lua_quote(chord)}," for chord in store["unbind"]]
    lines += ["    },", "    binds = {"]
    for bind in store["binds"]:
        fields = [f"id = {lua_quote(bind['id'])}", f"chord = {lua_quote(bind['chord'])}"]
        if isinstance(bind.get("exec"), str):
            fields.append(f"exec = {lua_quote(bind['exec'])}")
        else:
            fields.append(f"global = {lua_quote(bind['global'])}")
        lines.append("        { " + ", ".join(fields) + " },")
    lines += ["    },", "}", ""]
    return "\n".join(lines)


def atomic_write(path: Path, text: str) -> None:
    refuse_symlink(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


# --- what Hyprland ends up with ---------------------------------------------

def simple_action(body: str) -> dict | None:
    """The exec or global target of a bind body, when that is all it does."""
    match = re.fullmatch(r'hl\.dsp\.global\(\s*"([^"\\]+)"\s*\)\s*(?:,\s*[A-Za-z_]+\s*)?', body, re.S)
    if match:
        return {"global": match.group(1)}
    match = re.fullmatch(r'hl\.dsp\.exec_cmd\(\s*(?:\[\[(.*?)\]\]|"((?:\\.|[^"\\])*)")\s*\)\s*', body, re.S)
    if match:
        return {"exec": match.group(1) if match.group(1) is not None else lua_unescape(match.group(2))}
    return None


def generated_app(text: str, bind_start: int) -> tuple[str, str] | None:
    prefix = text[:bind_start]
    match = None
    for candidate in APP_COMMENT_RE.finditer(prefix):
        match = candidate
    if not match or prefix[match.end():].strip():
        return None
    return match.group(1), match.group(2)


def user_bindings(store: dict) -> list[dict]:
    if not USER.exists():
        return []
    text = USER.read_text(encoding="utf-8")
    removed = {normalise(chord) for chord in store["unbind"]}
    result = []
    for block in binding_blocks(text):
        identifier = "user:" + digest(block.chord, block.body)
        action = simple_action(block.body)
        target = (action or {}).get("global", "")
        command = (action or {}).get("exec", "")
        app = generated_app(text, block.start)
        item = {
            "id": identifier, "label": app[0] if app else target.replace("cortetsu:", "Cortetsu · ") or command or "Acción Lua",
            "chord": block.chord, "group": "Application" if app else "Custom",
            "description": command or target or "Acción Lua de hypr-user.lua",
            "command": command, "origin": "user", "editable": action is not None, "action": action,
            "deletable": True, "active": normalise(block.chord) not in removed,
        }
        if app:
            item.update({"appName": app[0], "appId": app[1]})
        if action is None:
            item["note"] = "Acción Lua: se cambia en hypr-user.lua"
        result.append(item)
    return result


def first_party_literals() -> list[dict]:
    """Binds keybinds.lua writes with a fixed chord: hardware keys and the like."""
    if not FIRST_PARTY.exists():
        return []
    result = []
    for match in LITERAL_BIND_RE.finditer(FIRST_PARTY.read_text(encoding="utf-8")):
        action = match.group(2)
        target = re.search(r'hl\.dsp\.global\("([^"]+)"', action)
        command = re.search(r'hl\.dsp\.exec_cmd\("((?:\\.|[^"])*)"', action)
        for chord in values(match.group(1)):
            hardware = chord.upper().startswith("XF86")
            result.append({
                "id": "fixed:" + digest(chord), "label": target.group(1).replace("cortetsu:", "Cortetsu · ") if target
                else (lua_unescape(command.group(1)) if command else chord),
                "chord": chord, "group": "Hardware" if hardware else "Cortetsu",
                "description": "Tecla del equipo" if hardware else "Atajo fijo de Cortetsu",
                "command": "", "origin": "fixed", "editable": False, "deletable": False, "active": True,
                "reserved": True,
            })
    return result


def list_bindings() -> list[dict]:
    store = load_store()
    defaults = entries(DEFAULTS)
    effective = defaults | {name: chords for name, chords in store["variables"].items()}
    result = []
    # Only variables the Lua actually binds; a defined but unused kb* would
    # list a shortcut that never exists.
    used = set(re.findall(r"\bvars\.(kb\w+)", FIRST_PARTY.read_text(encoding="utf-8") if FIRST_PARTY.exists() else ""))
    for name, default_values in defaults.items():
        if name not in used or (default_values and all(only_modifiers(chord) for chord in default_values)):
            continue
        edited = name in store["variables"]
        current = store["variables"].get(name, default_values)
        command_values = effective.get(APP_COMMANDS.get(name, ""), [])
        command = command_values[0] if command_values else ""
        for index, chord in enumerate(current):
            result.append({
                "id": f"var:{name}:{index}", "label": title(name), "chord": chord,
                "group": "Application" if command else "Cortetsu",
                "description": command or title(name), "command": command,
                "appQuery": APP_QUERIES.get(name, Path(command.split()[0]).name if command else ""),
                "origin": "edited" if edited else "default", "variable": name,
                "editable": True, "deletable": True, "resettable": edited, "active": True,
            })
        if edited and not current:
            result.append({
                "id": f"var:{name}:-", "label": title(name), "chord": "", "group": "Cortetsu",
                "description": "Sin combinación", "command": command, "origin": "edited", "variable": name,
                "editable": False, "deletable": False, "resettable": True, "active": False,
            })
    for item in user_bindings(store):
        item["resettable"] = not item["active"]
        result.append(item)
    for bind in store["binds"]:
        result.append({
            "id": bind["id"], "label": bind.get("name") or bind.get("global", "").replace("cortetsu:", "Cortetsu · ")
            or bind.get("exec", ""), "chord": bind["chord"],
            "group": "Application" if bind.get("appId") else "Custom",
            "description": bind.get("exec") or bind.get("global", ""), "command": bind.get("exec", ""),
            "appName": bind.get("name", ""), "appId": bind.get("appId", ""), "origin": "edited",
            "editable": True, "deletable": True, "resettable": bool(bind.get("replaces")), "active": True,
        })
    result.extend(first_party_literals())
    owners: dict[str, list[dict]] = {}
    for item in result:
        if item["active"] and item["chord"]:
            owners.setdefault(normalise(item["chord"]), []).append(item)
    for item in result:
        others = [other["label"] for other in owners.get(normalise(item["chord"]), []) if other["id"] != item["id"]]
        item["conflicts"] = others if item["active"] else []
    return sorted(result, key=lambda item: (item["group"], item["label"], item["chord"]))


def live_binds() -> list[dict] | None:
    """Hyprland's binds, or None when it cannot be asked."""
    try:
        completed = subprocess.run([HYPRCTL, "binds", "-j"], text=True, capture_output=True, timeout=10)
        return json.loads(completed.stdout) if completed.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def binds_on(chord: str) -> int:
    mask, key = chord_parts(chord)
    return sum(bind.get("modmask") == mask and str(bind.get("key", "")).upper() == key for bind in live_binds() or [])


def ensure_free(chord: str, own: set[str], items: list[dict]) -> None:
    wanted = normalise(chord)
    for item in items:
        if item["active"] and item["chord"] and normalise(item["chord"]) == wanted and normalise(item["chord"]) not in own:
            raise KeybindError(f"{chord} ya es «{item['label']}»")
    if wanted in own:
        return
    mask, key = chord_parts(chord)
    # Workspace binds are generated in Lua and only Hyprland knows them all.
    if any(bind.get("modmask") == mask and str(bind.get("key", "")).upper() == key for bind in live_binds() or []):
        raise KeybindError(f"{chord} ya lo usa otra acción de Hyprland")


# --- transactions -----------------------------------------------------------

def snapshot() -> Path:
    # The latest 20 are enough to undo by hand; older ones are dropped.
    for old in sorted(SNAPSHOTS.glob("*"))[:-19] if SNAPSHOTS.is_dir() else []:
        shutil.rmtree(old, ignore_errors=True)
    target = SNAPSHOTS / datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    target.mkdir(parents=True, exist_ok=False)
    for path in (STORE, COMPILED):
        if path.exists():
            shutil.copy2(path, target / path.name)
    return target


def restore(saved: Path) -> None:
    for path in (STORE, COMPILED):
        if (saved / path.name).exists():
            shutil.copy2(saved / path.name, path)
        elif path.exists() and not path.is_symlink():
            path.unlink()
    subprocess.run([HYPRCTL, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)


# Bind descriptions shared with the Lua side: keybinds.lua tags kb* binds with
# "cortetsu:<variable>", hyprland.lua tags edits with "cortetsu-keybinds:<id>".
VAR_TAG = "cortetsu:"
EDIT_TAG = "cortetsu-keybinds:"


def commit(store: dict, expect_present: list[tuple[str, str]], expect_absent: list[str]) -> Path:
    """Write the store, reload Hyprland and check the result, or roll back.

    expect_present: (chord, description) pairs that must be bound afterwards.
    expect_absent: chords that must have no bind afterwards.
    """
    # Before the snapshot: restoring through a symlink would write elsewhere.
    refuse_symlink(STORE)
    refuse_symlink(COMPILED)
    compiled = compile_store(store)
    saved = snapshot()
    try:
        if LUAC:
            with tempfile.NamedTemporaryFile("w", suffix=".lua", encoding="utf-8") as probe:
                probe.write(compiled)
                probe.flush()
                check = subprocess.run([LUAC, "-p", probe.name], capture_output=True, text=True)
            if check.returncode != 0:
                raise KeybindError("La configuración generada no es Lua válido: " + check.stderr.strip())
        atomic_write(STORE, json.dumps(store, indent=2, ensure_ascii=False) + "\n")
        atomic_write(COMPILED, compiled)
        reload = subprocess.run([HYPRCTL, "reload"], text=True, capture_output=True, timeout=15)
        if reload.returncode != 0:
            raise KeybindError("Hyprland no pudo recargar la configuración")
        active = live_binds()
        if active is None:
            raise KeybindError("No se pudo leer la configuración de Hyprland tras recargar")
        bound: dict[tuple[int, str], list[str]] = {}
        for bind in active:
            bound.setdefault((bind.get("modmask"), str(bind.get("key", "")).upper()), []).append(bind.get("description", ""))
        for chord, description in expect_present:
            if description not in bound.get(chord_parts(chord), []):
                raise KeybindError(f"Hyprland no muestra {chord} con su acción tras recargar")
        for chord in expect_absent:
            if chord_parts(chord) in bound:
                raise KeybindError(f"{chord} sigue activo tras recargar")
    except BaseException:
        restore(saved)
        raise
    return saved


def parse_var_id(identifier: str) -> tuple[str, int | None]:
    _, name, raw = identifier.split(":", 2)
    return name, None if raw == "-" else int(raw)


def find(identifier: str, items: list[dict]) -> dict:
    item = next((item for item in items if item["id"] == identifier), None)
    if item is None:
        raise KeybindError("Ese atajo ya no existe")
    return item


def vacated(item: dict, chord: str) -> list[str]:
    """The old chord, when moving away from it should leave it unbound."""
    if item["conflicts"] or normalise(item["chord"]) == normalise(chord):
        return []
    return [item["chord"]]


def unrestricted(store: dict, chord: str) -> None:
    """Give a hypr-user chord back: drop its removal and any edit replacing it."""
    store["unbind"] = [other for other in store["unbind"] if normalise(other) != normalise(chord)]
    store["binds"] = [bind for bind in store["binds"] if normalise(bind.get("replaces", "")) != normalise(chord)]


def set_binding(identifier: str, raw_chord: str) -> dict:
    chord = validate_chord(raw_chord)
    items = list_bindings()
    item = find(identifier, items)
    if not item["editable"]:
        raise KeybindError(item.get("note") or "Este atajo no se puede cambiar desde aquí")
    store = load_store()
    ensure_free(chord, {normalise(item["chord"])}, items)
    if identifier.startswith("var:"):
        name, index = parse_var_id(identifier)
        current = list(store["variables"].get(name, entries(DEFAULTS).get(name, [])))
        current[index] = chord
        store["variables"][name] = current
        saved = commit(store, [(chord, VAR_TAG + name)], vacated(item, chord))
    elif identifier.startswith("user:"):
        if item["conflicts"] or binds_on(item["chord"]) > 1:
            raise KeybindError(f"{item['chord']} también lo usa otra acción; cámbiala primero")
        # Keyed by the chord it replaces, which is also what unbind stores, so
        # an edit of the line in hypr-user.lua does not orphan it.
        replacement = "edit:" + digest(normalise(item["chord"]))
        unrestricted(store, item["chord"])
        store["unbind"].append(item["chord"])
        store["binds"].append({"id": replacement, "chord": chord, "replaces": item["chord"],
                               "name": item.get("appName") or item["label"], "appId": item.get("appId", ""),
                               **item["action"]})
        saved = commit(store, [(chord, EDIT_TAG + replacement)], [item["chord"]])
    else:
        store["binds"] = [dict(bind, chord=chord) if bind["id"] == identifier else bind for bind in store["binds"]]
        saved = commit(store, [(chord, EDIT_TAG + identifier)], vacated(item, chord))
    return {"ok": True, "snapshot": str(saved), "chord": chord, "message": f"Guardado · {chord}"}


def delete_binding(identifier: str) -> dict:
    item = find(identifier, list_bindings())
    if not item["deletable"]:
        raise KeybindError("Este atajo no se puede eliminar desde aquí")
    store = load_store()
    if identifier.startswith("var:"):
        name, index = parse_var_id(identifier)
        current = list(store["variables"].get(name, entries(DEFAULTS).get(name, [])))
        current.pop(index)
        store["variables"][name] = current
    elif identifier.startswith("user:"):
        if item["conflicts"] or binds_on(item["chord"]) > 1:
            raise KeybindError(f"{item['chord']} también lo usa otra acción; quitarlo las borraría todas")
        store["unbind"].append(item["chord"])
    else:
        # Deleting the edit of a hypr-user bind leaves the original removed;
        # resetting the original brings it back.
        store["binds"] = [bind for bind in store["binds"] if bind["id"] != identifier]
    saved = commit(store, [], [item["chord"]] if not item["conflicts"] else [])
    return {"ok": True, "snapshot": str(saved), "message": f"Eliminado · {item['label']}"}


def reset_binding(identifier: str) -> dict:
    item = find(identifier, list_bindings())
    if not item.get("resettable"):
        raise KeybindError("Este atajo no tiene cambios que deshacer")
    store = load_store()
    present: list[tuple[str, str]] = []
    if identifier.startswith("var:"):
        name, _ = parse_var_id(identifier)
        store["variables"].pop(name, None)
        present = [(chord, VAR_TAG + name) for chord in entries(DEFAULTS).get(name, [])]
    elif identifier.startswith("user:"):
        unrestricted(store, item["chord"])
    else:
        bind = next((bind for bind in store["binds"] if bind["id"] == identifier), None)
        if bind is None or not bind.get("replaces"):
            raise KeybindError("Este atajo no tiene cambios que deshacer")
        unrestricted(store, bind["replaces"])
    saved = commit(store, present, [])
    return {"ok": True, "snapshot": str(saved), "message": f"Restablecido · {item['label']}"}


def add_app(app_id: str, name: str, command: str, raw_chord: str) -> dict:
    if not app_id or not name or not command:
        raise KeybindError("La aplicación elegida no tiene datos de lanzamiento completos")
    command = re.sub(r"\s+%[fFuUdDnNickvm]", "", command).replace("%%", "%").strip()
    if "\n" in command or "\0" in command:
        raise KeybindError("El comando de la aplicación no se puede guardar de forma segura")
    chord = validate_chord(raw_chord)
    ensure_free(chord, set(), list_bindings())
    store = load_store()
    identifier = "app:" + digest(app_id, chord)
    store["binds"] = [bind for bind in store["binds"] if bind["id"] != identifier]
    store["binds"].append({"id": identifier, "chord": chord, "exec": command, "name": name, "appId": app_id})
    saved = commit(store, [(chord, EDIT_TAG + identifier)], [])
    return {"ok": True, "snapshot": str(saved), "chord": chord, "message": f"Guardado · {chord}"}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    setter = sub.add_parser("set")
    setter.add_argument("identifier")
    setter.add_argument("chord")
    for verb in ("delete", "reset"):
        sub.add_parser(verb).add_argument("identifier")
    app = sub.add_parser("add-app")
    app.add_argument("app_id")
    app.add_argument("name")
    app.add_argument("command")
    app.add_argument("chord")
    args = parser.parse_args()
    try:
        if args.command == "list":
            result = {"ok": True, "bindings": list_bindings()}
        elif args.command == "set":
            result = set_binding(args.identifier, args.chord)
        elif args.command == "delete":
            result = delete_binding(args.identifier)
        elif args.command == "reset":
            result = reset_binding(args.identifier)
        else:
            result = add_app(args.app_id, args.name, args.command, args.chord)
    except (KeybindError, OSError, ValueError, subprocess.SubprocessError) as error:
        result = {"ok": False, "error": str(error) or "El atajo no se pudo cambiar"}
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
