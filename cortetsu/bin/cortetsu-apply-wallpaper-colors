#!/usr/bin/env bash
set -euo pipefail

image="${1:-}"
[[ -n "$image" && -f "$image" ]] || { echo "usage: cortetsu-apply-wallpaper-colors /path/to/image" >&2; exit 2; }

payload="$("$HOME/.local/bin/cortetsu-wallpaper-colours" "$image")"
# The native scheme writer validates the palette, serializes against manual
# selections and rechecks wallpaper ownership while holding the shared lock.
if printf '%s\n' "$payload" | "$HOME/.local/bin/cortetsu-scheme" apply-wallpaper-colors; then
    :
else
    status=$?
    [[ "$status" -eq 3 ]] && exit 3
    exit "$status"
fi
"$HOME/.local/bin/cortetsu-scheme" sync-kitty || echo "cortetsu-apply-wallpaper-colors: Kitty colours kept unchanged" >&2
