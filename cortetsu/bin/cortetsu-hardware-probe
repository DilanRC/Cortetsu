#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import socket
import subprocess
import time
from pathlib import Path

UID = os.getuid()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{UID}"))
STATE_PATH = RUNTIME / "cortetsu-hardware-probe-state.json"
CLK_TCK = int(os.sysconf("SC_CLK_TCK"))
PAGE_SIZE = int(os.sysconf("SC_PAGE_SIZE"))


def read_text(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return default


def read_num(path: Path, scale: float = 1.0):
    raw = read_text(path)
    if not raw:
        return None
    try:
        return float(raw) / scale
    except ValueError:
        return None


def clamp(value, low=0.0, high=100.0):
    if value is None:
        return None
    return max(low, min(high, float(value)))


def bytes_gib(value: float) -> float:
    return round(value / (1024 ** 3), 2)


def load_state() -> dict:
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict) -> None:
    try:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps(state), encoding="utf-8")
        tmp.replace(STATE_PATH)
    except OSError:
        pass


def cpu_numbers(line: str) -> list[int]:
    out = []
    for value in line.split()[1:]:
        try:
            out.append(int(value))
        except ValueError:
            pass
    return out


def cpu_total_idle(nums: list[int]) -> tuple[int, int]:
    total = sum(nums)
    idle = (nums[3] if len(nums) > 3 else 0) + (nums[4] if len(nums) > 4 else 0)
    return total, idle


def cpu_percent(total: int, idle: int, prev_total: int, prev_idle: int) -> float:
    delta_total = max(0, total - prev_total)
    delta_idle = max(0, idle - prev_idle)
    if delta_total <= 0:
        return 0.0
    return round(clamp((1.0 - delta_idle / delta_total) * 100.0) or 0.0, 1)


def cpu_snapshot(previous: dict) -> tuple[dict, dict]:
    lines = read_text(Path("/proc/stat")).splitlines()
    global_line = next((line for line in lines if line.startswith("cpu ")), "")
    global_nums = cpu_numbers(global_line)
    total, idle = cpu_total_idle(global_nums)
    usage = cpu_percent(
        total,
        idle,
        int(previous.get("cpu_total", total)),
        int(previous.get("cpu_idle", idle)),
    )

    prev_cores = previous.get("cpu_cores", {})
    core_state = {}
    per_core = []
    for line in lines:
        match = re.match(r"^cpu(\d+)\s", line)
        if not match:
            continue
        core = match.group(1)
        nums = cpu_numbers(line)
        c_total, c_idle = cpu_total_idle(nums)
        old = prev_cores.get(core, {})
        per_core.append(
            cpu_percent(
                c_total,
                c_idle,
                int(old.get("total", c_total)),
                int(old.get("idle", c_idle)),
            )
        )
        core_state[core] = {"total": c_total, "idle": c_idle}

    model = ""
    mhz_values = []
    for line in read_text(Path("/proc/cpuinfo")).splitlines():
        if not model and line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
        elif line.startswith("cpu MHz"):
            try:
                mhz_values.append(float(line.split(":", 1)[1].strip()))
            except ValueError:
                pass

    cpufreq_root = Path("/sys/devices/system/cpu")
    cur_values = []
    for p in cpufreq_root.glob("cpu[0-9]*/cpufreq/scaling_cur_freq"):
        value = read_num(p, 1000.0)
        if value:
            cur_values.append(value)
    freq = sum(cur_values) / len(cur_values) if cur_values else (sum(mhz_values) / len(mhz_values) if mhz_values else None)

    governors = {
        read_text(p)
        for p in cpufreq_root.glob("cpu[0-9]*/cpufreq/scaling_governor")
        if read_text(p)
    }

    temp_candidates = []
    for hwmon in Path("/sys/class/hwmon").glob("hwmon*"):
        name = read_text(hwmon / "name").lower()
        if name in {"k10temp", "zenpower", "coretemp"}:
            for p in hwmon.glob("temp*_input"):
                value = read_num(p, 1000.0)
                if value is not None and -20 < value < 130:
                    temp_candidates.append(value)
    temp = max(temp_candidates) if temp_candidates else None

    return (
        {
            "model": model or "CPU",
            "usage": usage,
            "per_core": per_core,
            "freq_mhz": round(freq, 0) if freq else None,
            "temp_c": round(temp, 1) if temp is not None else None,
            "governor": ", ".join(sorted(governors)) if governors else "unknown",
            "cores": len(per_core) or (os.cpu_count() or 0),
        },
        {
            "cpu_total": total,
            "cpu_idle": idle,
            "cpu_cores": core_state,
        },
    )


def memory_snapshot() -> tuple[dict, int]:
    info = {}
    for line in read_text(Path("/proc/meminfo")).splitlines():
        if ":" not in line:
            continue
        key, raw = line.split(":", 1)
        try:
            info[key] = int(raw.strip().split()[0]) * 1024
        except (ValueError, IndexError):
            pass
    total = info.get("MemTotal", 0)
    available = info.get("MemAvailable", 0)
    used = max(0, total - available)
    cache = info.get("Cached", 0) + info.get("SReclaimable", 0)
    buffers = info.get("Buffers", 0)
    swap_total = info.get("SwapTotal", 0)
    swap_free = info.get("SwapFree", 0)
    return (
        {
            "total_gb": bytes_gib(total),
            "used_gb": bytes_gib(used),
            "available_gb": bytes_gib(available),
            "cache_gb": bytes_gib(cache),
            "buffers_gb": bytes_gib(buffers),
            "usage": round((used / total * 100.0) if total else 0.0, 1),
            "swap_used_gb": bytes_gib(max(0, swap_total - swap_free)),
            "swap_total_gb": bytes_gib(swap_total),
        },
        total,
    )


def disk_snapshot() -> dict:
    usage = shutil.disk_usage("/")
    return {
        "total_gb": bytes_gib(usage.total),
        "used_gb": bytes_gib(usage.used),
        "free_gb": bytes_gib(usage.free),
        "usage": round(usage.used / usage.total * 100.0 if usage.total else 0.0, 1),
    }


def root_source_name() -> str:
    if shutil.which("findmnt"):
        try:
            cp = subprocess.run(
                ["findmnt", "-n", "-o", "SOURCE", "/"],
                text=True,
                capture_output=True,
                timeout=0.7,
                check=False,
            )
            source = cp.stdout.strip().split("[", 1)[0]
            if source.startswith("/dev/"):
                name = Path(source).name
                sys_block = Path("/sys/class/block") / name
                if sys_block.exists():
                    resolved = sys_block.resolve()
                    if (sys_block / "partition").exists():
                        return resolved.parent.name
                    if name.startswith("dm-"):
                        slaves = list((sys_block / "slaves").glob("*"))
                        if slaves:
                            slave = slaves[0].name
                            slave_path = Path("/sys/class/block") / slave
                            if (slave_path / "partition").exists():
                                return slave_path.resolve().parent.name
                            return slave
                    return name
        except (OSError, subprocess.SubprocessError):
            pass
    return ""


def block_device_names() -> list[str]:
    names = []
    root = Path("/sys/class/block")
    for path in root.iterdir():
        name = path.name
        if (path / "partition").exists():
            continue
        if name.startswith(("loop", "ram", "zram", "dm-", "md")):
            continue
        if re.match(r"^(nvme\d+n\d+|sd[a-z]+|vd[a-z]+|mmcblk\d+)$", name):
            names.append(name)
    return sorted(names)


def block_metric(name: str, old: dict, elapsed: float) -> tuple[dict, dict] | tuple[None, None]:
    root = Path("/sys/class/block") / name
    try:
        fields = [int(v) for v in read_text(root / "stat").split()]
        if len(fields) < 7:
            return None, None
        reads, read_sectors = fields[0], fields[2]
        writes, write_sectors = fields[4], fields[6]
        sector_size = int(read_text(root / "queue/hw_sector_size", "512") or 512)
    except (OSError, ValueError):
        return None, None

    read_mib = max(0, read_sectors - int(old.get("read_sectors", read_sectors))) * sector_size / (1024 ** 2) / elapsed
    write_mib = max(0, write_sectors - int(old.get("write_sectors", write_sectors))) * sector_size / (1024 ** 2) / elapsed
    read_iops = max(0, reads - int(old.get("reads", reads))) / elapsed
    write_iops = max(0, writes - int(old.get("writes", writes))) / elapsed

    model = read_text(root / "device/model") or read_text(root / "device/name")
    serial = read_text(root / "device/serial")
    metric = {
        "device": name,
        "model": model,
        "serial": serial,
        "rotational": read_text(root / "queue/rotational", "0") == "1",
        "read_mib_s": round(read_mib, 2),
        "write_mib_s": round(write_mib, 2),
        "read_iops": round(read_iops, 1),
        "write_iops": round(write_iops, 1),
        "read_total_gb": round(read_sectors * sector_size / 1_000_000_000, 2),
        "write_total_gb": round(write_sectors * sector_size / 1_000_000_000, 2),
    }
    state = {
        "read_sectors": read_sectors,
        "write_sectors": write_sectors,
        "reads": reads,
        "writes": writes,
    }
    return metric, state


def disk_io_snapshot(previous: dict, now: float) -> tuple[dict, list[dict], dict]:
    old_root = previous.get("disk_io", {})
    old_devices = old_root.get("devices", {})
    elapsed = max(0.001, now - float(old_root.get("time", now)))
    devices = []
    next_devices = {}

    for name in block_device_names():
        metric, state = block_metric(name, old_devices.get(name, {}), elapsed)
        if metric is None:
            continue
        devices.append(metric)
        next_devices[name] = state

    root_name = root_source_name()
    root_metric = next((d for d in devices if d.get("device") == root_name), None)
    if root_metric is None and devices:
        root_metric = devices[0]
    if root_metric is None:
        root_metric = {
            "device": root_name or "root",
            "model": "",
            "serial": "",
            "read_mib_s": 0.0,
            "write_mib_s": 0.0,
            "read_iops": 0.0,
            "write_iops": 0.0,
            "read_total_gb": 0.0,
            "write_total_gb": 0.0,
        }

    return root_metric, devices, {"disk_io": {"time": now, "devices": next_devices}}


def battery_snapshot() -> dict:
    roots = sorted(Path("/sys/class/power_supply").glob("BAT*"))
    if not roots:
        return {"present": False}
    root = roots[0]
    percent = read_num(root / "capacity")
    power_uw = read_num(root / "power_now")
    if power_uw is None:
        current = read_num(root / "current_now")
        voltage = read_num(root / "voltage_now")
        if current is not None and voltage is not None:
            power_uw = current * voltage / 1_000_000.0
    return {
        "present": True,
        "name": root.name,
        "percent": round(percent, 0) if percent is not None else None,
        "status": read_text(root / "status", "Unknown"),
        "power_w": round(power_uw / 1_000_000.0, 1) if power_uw is not None else None,
    }


def default_interface() -> str:
    for line in read_text(Path("/proc/net/route")).splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 4 and parts[1] == "00000000":
            try:
                if int(parts[3], 16) & 0x2:
                    return parts[0]
            except ValueError:
                pass
    for p in Path("/sys/class/net").iterdir():
        if p.name != "lo" and read_text(p / "operstate") == "up":
            return p.name
    return ""


def network_metadata(iface: str) -> dict:
    data = {
        "mac": read_text(Path("/sys/class/net") / iface / "address"),
        "ipv4": "",
        "ssid": "",
        "signal_dbm": None,
        "bitrate_mbps": None,
    }

    if shutil.which("ip"):
        try:
            cp = subprocess.run(
                ["ip", "-4", "-o", "addr", "show", "dev", iface],
                text=True,
                capture_output=True,
                timeout=0.6,
                check=False,
            )
            match = re.search(r"\binet\s+([0-9.]+)/", cp.stdout)
            if match:
                data["ipv4"] = match.group(1)
        except (OSError, subprocess.SubprocessError):
            pass

    if shutil.which("iw") and (Path("/sys/class/net") / iface / "wireless").exists():
        try:
            cp = subprocess.run(
                ["iw", "dev", iface, "link"],
                text=True,
                capture_output=True,
                timeout=0.7,
                check=False,
            )
            for line in cp.stdout.splitlines():
                stripped = line.strip()
                if stripped.startswith("SSID:"):
                    data["ssid"] = stripped.split(":", 1)[1].strip()
                elif stripped.startswith("signal:"):
                    match = re.search(r"signal:\s*(-?[0-9.]+)", stripped)
                    if match:
                        data["signal_dbm"] = round(float(match.group(1)), 0)
                elif stripped.startswith("tx bitrate:"):
                    match = re.search(r"tx bitrate:\s*([0-9.]+)", stripped)
                    if match:
                        data["bitrate_mbps"] = round(float(match.group(1)), 1)
        except (OSError, subprocess.SubprocessError, ValueError):
            pass

    return data


def network_snapshot(previous: dict, now: float) -> tuple[dict, dict]:
    iface = default_interface()
    if not iface:
        return {"interface": "", "rx_mbps": 0.0, "tx_mbps": 0.0}, {}
    root = Path("/sys/class/net") / iface / "statistics"
    rx = int(read_text(root / "rx_bytes", "0") or 0)
    tx = int(read_text(root / "tx_bytes", "0") or 0)
    old = previous.get("network", {})
    elapsed = max(0.001, now - float(old.get("time", now)))
    rx_rate = max(0, rx - int(old.get("rx", rx))) * 8 / elapsed / 1_000_000
    tx_rate = max(0, tx - int(old.get("tx", tx))) * 8 / elapsed / 1_000_000
    metadata = network_metadata(iface)
    return (
        {
            "interface": iface,
            "rx_mbps": round(rx_rate, 2),
            "tx_mbps": round(tx_rate, 2),
            "rx_total_gb": round(rx / 1_000_000_000, 2),
            "tx_total_gb": round(tx / 1_000_000_000, 2),
            **metadata,
        },
        {"network": {"time": now, "rx": rx, "tx": tx}},
    )


def pci_name(slot: str, fallback: str) -> str:
    if not slot or not shutil.which("lspci"):
        return fallback
    try:
        cp = subprocess.run(
            ["lspci", "-s", slot],
            text=True,
            capture_output=True,
            timeout=0.8,
            check=False,
        )
        text = cp.stdout.strip()
        if ": " in text:
            return text.split(": ", 1)[1]
    except (OSError, subprocess.SubprocessError):
        pass
    return fallback


def amd_gpu_snapshot() -> list[dict]:
    out = []
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]")):
        device = card / "device"
        if read_text(device / "vendor").lower() != "0x1002":
            continue
        uevent = {}
        for line in read_text(device / "uevent").splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                uevent[k] = v
        temp = None
        power = None
        hwmon_root = device / "hwmon"
        if hwmon_root.exists():
            for hwmon in hwmon_root.glob("hwmon*"):
                temps = [read_num(p, 1000.0) for p in hwmon.glob("temp*_input")]
                temps = [v for v in temps if v is not None and -20 < v < 130]
                if temps:
                    temp = max(temps)
                pwr = read_num(hwmon / "power1_average", 1_000_000.0)
                if pwr is not None:
                    power = pwr
        busy = read_num(device / "gpu_busy_percent")
        vram_total = read_num(device / "mem_info_vram_total")
        vram_used = read_num(device / "mem_info_vram_used")
        slot = uevent.get("PCI_SLOT_NAME", "")
        out.append(
            {
                "vendor": "AMD",
                "card": card.name,
                "name": pci_name(slot, "AMD Radeon GPU"),
                "usage": round(clamp(busy) or 0.0, 1),
                "temp_c": round(temp, 1) if temp is not None else None,
                "vram_total_gb": bytes_gib(vram_total) if vram_total else None,
                "vram_used_gb": bytes_gib(vram_used) if vram_used else None,
                "power_w": round(power, 1) if power is not None else None,
            }
        )
    return out


def nvidia_gpu_snapshot() -> list[dict]:
    if not shutil.which("nvidia-smi"):
        return []
    query = "name,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw"
    try:
        cp = subprocess.run(
            ["nvidia-smi", f"--query-gpu={query}", "--format=csv,noheader,nounits"],
            text=True,
            capture_output=True,
            timeout=1.5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if cp.returncode != 0:
        return []
    out = []
    for line in cp.stdout.splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) < 6:
            continue

        def f(index):
            try:
                return float(parts[index])
            except ValueError:
                return None

        used_mib, total_mib = f(3), f(4)
        out.append(
            {
                "vendor": "NVIDIA",
                "name": parts[0],
                "usage": round(clamp(f(1)) or 0.0, 1),
                "temp_c": round(f(2), 1) if f(2) is not None else None,
                "vram_used_gb": round(used_mib / 1024, 2) if used_mib is not None else None,
                "vram_total_gb": round(total_mib / 1024, 2) if total_mib is not None else None,
                "power_w": round(f(5), 1) if f(5) is not None else None,
            }
        )
    return out


def fans_snapshot() -> list[dict]:
    out = []
    for hwmon in Path("/sys/class/hwmon").glob("hwmon*"):
        chip = read_text(hwmon / "name", hwmon.name)
        for inp in hwmon.glob("fan*_input"):
            match = re.search(r"fan(\d+)_input", inp.name)
            idx = match.group(1) if match else ""
            rpm = read_num(inp)
            if rpm is None or rpm <= 0:
                continue
            label = read_text(hwmon / f"fan{idx}_label", f"{chip} fan {idx}")
            out.append({"name": label, "rpm": round(rpm)})
    return out[:8]


def process_snapshot(previous: dict, now: float, uptime: float, total_mem: int) -> tuple[list[dict], dict]:
    old_ticks = previous.get("process_ticks", {})
    elapsed = max(0.001, now - float(previous.get("process_time", now)))
    current_ticks = {}
    user_cache = {}
    out = []
    self_pid = os.getpid()

    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        pid = int(proc.name)
        if pid == self_pid:
            continue

        stat_text = read_text(proc / "stat")
        end = stat_text.rfind(")")
        if end < 0:
            continue
        fields = stat_text[end + 2 :].split()
        if len(fields) < 22:
            continue

        try:
            state = fields[0]
            ppid = int(fields[1])
            ticks = int(fields[11]) + int(fields[12])
            threads = int(fields[17])
            start_ticks = int(fields[19])
            rss_pages = int(fields[21])
            uid = proc.stat().st_uid
        except (ValueError, OSError):
            continue

        current_ticks[str(pid)] = ticks
        delta_ticks = max(0, ticks - int(old_ticks.get(str(pid), ticks)))
        cpu = delta_ticks / max(1, CLK_TCK) / elapsed * 100.0
        mem = (rss_pages * PAGE_SIZE / total_mem * 100.0) if total_mem > 0 else 0.0

        if uid not in user_cache:
            try:
                user_cache[uid] = pwd.getpwuid(uid).pw_name
            except KeyError:
                user_cache[uid] = str(uid)

        name = read_text(proc / "comm", proc.name)
        raw_cmdline = read_text(proc / "cmdline")
        command = raw_cmdline.replace("\x00", " ").strip() if raw_cmdline else name
        elapsed_sec = max(0.0, uptime - start_ticks / max(1, CLK_TCK))

        out.append(
            {
                "pid": pid,
                "ppid": ppid,
                "name": name,
                "user": user_cache[uid],
                "state": state,
                "threads": threads,
                "elapsed_sec": round(elapsed_sec),
                "cpu": round(cpu, 1),
                "mem": round(mem, 1),
                "command": command[:700],
            }
        )

    # Keep the default view sorted by activity, but do not truncate the source.
    # ProcessesPage applies its own filter/sort, so PID/name/command searches must
    # be able to reach low-CPU and sleeping processes as well.
    out.sort(key=lambda p: (-p["cpu"], -p["mem"], p["name"].lower()))
    return (
        out,
        {
            "process_time": now,
            "process_ticks": current_ticks,
        },
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Print one hardware telemetry sample as JSON.")
    parser.add_argument(
        "--top-processes",
        type=int,
        default=0,
        metavar="N",
        help="emit only the N most active processes; 0 emits every readable process",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    previous = load_state()
    now = time.monotonic()

    try:
        uptime = float(read_text(Path("/proc/uptime"), "0").split()[0])
    except (ValueError, IndexError):
        uptime = 0.0

    cpu, cpu_state = cpu_snapshot(previous)
    memory, total_mem = memory_snapshot()
    network, network_state = network_snapshot(previous, now)
    disk_io, disks_io, disk_state = disk_io_snapshot(previous, now)
    processes, process_state = process_snapshot(previous, now, uptime, total_mem)

    state = {
        **cpu_state,
        **network_state,
        **disk_state,
        **process_state,
    }
    save_state(state)

    payload = {
        "timestamp": int(time.time()),
        "host": socket.gethostname(),
        "kernel": os.uname().release,
        "uptime_sec": round(uptime),
        "load": [round(v, 2) for v in os.getloadavg()],
        "cpu": cpu,
        "memory": memory,
        "disk": disk_snapshot(),
        "disk_io": disk_io,
        "disks_io": disks_io,
        "battery": battery_snapshot(),
        "network": network,
        "gpus": amd_gpu_snapshot() + nvidia_gpu_snapshot(),
        "fans": fans_snapshot(),
        # Every process is still scanned so CPU deltas stay correct for the
        # next sample; only the emitted list is trimmed.
        "processes": processes[: args.top_processes] if args.top_processes > 0 else processes,
        "process_count": len(processes),
    }
    print(json.dumps(payload, separators=(",", ":")))


if __name__ == "__main__":
    main()
