#!/usr/bin/env python3
"""First-party scheme state command used by the Cortetsu launcher."""
from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path


def state_path() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "cortetsu/scheme.json"


def read_state() -> dict:
    try:
        value = json.loads(state_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        value = {}
    return value if isinstance(value, dict) else {}


def write_state(value: dict) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        json.dump(value, handle, indent=2)
        handle.write("\n")
        temporary = Path(handle.name)
    os.replace(temporary, path)


def catalog() -> dict:
    """Return every shipped scheme, not only the currently selected state."""
    pack = Path(__file__).resolve().parents[1] / "data/schemes/cortetsu-pack"
    palette_file = Path(__file__).resolve().parents[1] / "data/schemes/palettes.json"
    import json as _json
    allowed = set(_json.loads(palette_file.read_text(encoding="utf-8"))) if palette_file.exists() else None
    result: dict[str, dict[str, dict[str, str]]] = {}
    for file in sorted(pack.glob("*/**/dark.txt")):
        relative = file.relative_to(pack)
        if len(relative.parts) != 3:
            continue
        name, flavour = relative.parts[:2]
        if allowed is not None and f"{name}/{flavour}" not in allowed:
            continue
        colours = {}
        for line in file.read_text(encoding="utf-8").splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2:
                colours[parts[0]] = parts[1].strip().lower()
        result.setdefault(name, {})[flavour] = colours
    return result


def main(argv: list[str]) -> int:
    state = read_state()
    if argv == ["list"]:
        schemes = catalog()
        current_name = state.get("name")
        current_flavour = state.get("flavour", "default")
        if current_name and current_name not in schemes:
            schemes[current_name] = {current_flavour: state.get("colours", {})}
        if not schemes:
            name = state.get("name", "dynamic")
            flavour = state.get("flavour", "default")
            schemes = {name: {flavour: state.get("colours", {})}}
        print(json.dumps(schemes, separators=(",", ":")))
        return 0
    if argv == ["get", "-nfv"]:
        print(state.get("name", "dynamic"))
        print(state.get("flavour", "default"))
        print(state.get("variant", "tonal-spot"))
        return 0
    if len(argv) == 4 and argv[:2] == ["set", "-n"] and argv[2]:
        state["name"], state["flavour"] = argv[2], argv[3]
        write_state(state)
        return 0
    if len(argv) == 3 and argv[:2] == ["set", "-v"] and argv[2]:
        state["variant"] = argv[2]
        write_state(state)
        return 0
    print("usage: cortetsu-scheme {list|get -nfv|set -n NAME FLAVOUR|set -v VARIANT}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
