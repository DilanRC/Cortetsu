#!/usr/bin/env python3
"""Restart-safe local Pomodoro state shared by Cortetsu and Quickshell.

    cortetsu-pomodoro [status|start|pause|resume|skip|reset]   print the state as JSON
    cortetsu-pomodoro daemon                                    announce phase ends

The state file is the single source of truth. Phases end at a wall-clock
timestamp, so the remaining time survives shell restarts and suspend. Every
phase end goes through settle(): whichever process notices it first (the
daemon or a command) saves the new phase and writes exactly one notification
event, under the state lock.
"""
from __future__ import annotations

import contextlib
import fcntl
import json
import os
import select
import signal
import sys
import time
from pathlib import Path
from typing import Any, Iterator

DEFAULT: dict[str, Any] = {
    "schema": 2,
    "phase": "IDLE",
    "targetEndTimestamp": 0.0,
    "pausedRemainingMs": 0,
    "pausedPhase": "FOCUS",
    "completedSessions": 0,
    "focusMinutes": 25,
    "shortBreakMinutes": 5,
    "longBreakMinutes": 15,
    "sessionsBeforeLongBreak": 4,
}
# User configuration: kept by `reset`, which only restarts the cycle.
CONFIG_KEYS = ("focusMinutes", "shortBreakMinutes", "longBreakMinutes", "sessionsBeforeLongBreak")
VALID_PHASES = {"IDLE", "FOCUS", "BREAK", "LONG_BREAK", "PAUSED", "COMPLETED"}
ACTIVE_PHASES = {"FOCUS", "BREAK", "LONG_BREAK"}
BREAK_PHASES = {"BREAK", "LONG_BREAK"}
COMMANDS = {"status", "start", "pause", "resume", "skip", "reset"}
# Without timerfd the daemon re-reads the clock at least this often, so a
# phase that ended during suspend is announced at most this late.
FALLBACK_POLL_SECONDS = 30.0


def path() -> Path:
    override = os.environ.get("CORTETSU_POMODORO_STATE")
    if override:
        return Path(override).expanduser()
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return state_home / "cortetsu/pomodoro.json"


def event_path() -> Path:
    return path().with_name("pomodoro-notification.json")


def state_lock_path() -> Path:
    return path().with_name("pomodoro-state.lock")


def daemon_lock_path() -> Path:
    return path().with_name("pomodoro-daemon.lock")


def normalize_state(raw: Any) -> dict[str, Any]:
    data = raw if isinstance(raw, dict) else {}
    state = {**DEFAULT, **data}
    if state.get("phase") not in VALID_PHASES:
        state["phase"] = "IDLE"
    if state["phase"] == "PAUSED" and state.get("pausedPhase") not in ACTIVE_PHASES:
        state["pausedPhase"] = "FOCUS"

    for key, fallback in (
        ("focusMinutes", 25),
        ("shortBreakMinutes", 5),
        ("longBreakMinutes", 15),
        ("sessionsBeforeLongBreak", 4),
    ):
        try:
            value = int(state.get(key, fallback))
        except (TypeError, ValueError):
            value = fallback
        state[key] = max(1, value)

    for key in ("completedSessions", "pausedRemainingMs"):
        try:
            value = int(state.get(key, 0))
        except (TypeError, ValueError):
            value = 0
        state[key] = max(0, value)

    try:
        state["targetEndTimestamp"] = max(0.0, float(state.get("targetEndTimestamp", 0)))
    except (TypeError, ValueError):
        state["targetEndTimestamp"] = 0.0
    # A running phase without a deadline would never end.
    if state["phase"] in ACTIVE_PHASES and not state["targetEndTimestamp"]:
        state["phase"] = "IDLE"
        state["pausedPhase"] = "FOCUS"
    state["schema"] = 2
    return state


def load() -> dict[str, Any]:
    try:
        raw = json.loads(path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        raw = {}
    return normalize_state(raw)


def write_atomically(destination: Path, text: str) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(f".{destination.name}.tmp.{os.getpid()}")
    with temporary.open("w", encoding="utf-8") as stream:
        stream.write(text)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.chmod(0o600)
    temporary.replace(destination)


def save(state: dict[str, Any]) -> None:
    write_atomically(path(), json.dumps(normalize_state(state), indent=2) + "\n")


@contextlib.contextmanager
def state_lock() -> Iterator[None]:
    lock_path = state_lock_path()
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def phase_duration_seconds(state: dict[str, Any], phase: str) -> int:
    if phase == "FOCUS":
        return int(state["focusMinutes"]) * 60
    if phase == "LONG_BREAK":
        return int(state["longBreakMinutes"]) * 60
    return int(state["shortBreakMinutes"]) * 60


def advance(state: dict[str, Any], now: float | None = None) -> dict[str, Any]:
    """The state at `now`. A phase that has ended gives way to the next one,
    which starts when the end is noticed (after a suspend, on wake)."""
    state = normalize_state(state)
    if state["phase"] not in ACTIVE_PHASES:
        return state
    current_time = time.time() if now is None else now
    target = float(state["targetEndTimestamp"])
    duration = phase_duration_seconds(state, state["phase"])
    if target - current_time > duration:
        # The wall clock went back: a phase never has more than its full length left.
        state["targetEndTimestamp"] = current_time + duration
        return state
    if current_time < target:
        return state

    if state["phase"] == "FOCUS":
        state["completedSessions"] += 1
        cycle = max(1, int(state["sessionsBeforeLongBreak"]))
        next_phase = "LONG_BREAK" if state["completedSessions"] % cycle == 0 else "BREAK"
    else:
        next_phase = "FOCUS"
    state["phase"] = next_phase
    state["targetEndTimestamp"] = current_time + phase_duration_seconds(state, next_phase)
    state["pausedRemainingMs"] = 0
    state["pausedPhase"] = next_phase
    return state


def notification_for_transition(old_phase: str, new_phase: str) -> tuple[str, str] | None:
    if old_phase == "FOCUS" and new_phase == "BREAK":
        return "Sesión de concentración completada", "Toca un descanso corto"
    if old_phase == "FOCUS" and new_phase == "LONG_BREAK":
        return "Ciclo de concentración completado", "Toca un descanso largo"
    if old_phase in BREAK_PHASES and new_phase == "FOCUS":
        return "Descanso terminado", "Listo para concentrarte"
    return None


def write_event(title: str, message: str) -> None:
    payload = {"sequence": time.time_ns(), "title": title, "message": message}
    write_atomically(event_path(), json.dumps(payload) + "\n")


def ensure_event_file() -> None:
    if not event_path().exists():
        write_atomically(event_path(), json.dumps({"sequence": 0}) + "\n")


def settle(state: dict[str, Any], now: float | None = None) -> dict[str, Any]:
    """Advance `state` to `now`, persisting a change and announcing a phase end.
    Call with the state lock held: the save and its event happen once."""
    settled = advance(state, now)
    if settled != state:
        save(settled)
        transition = notification_for_transition(state["phase"], settled["phase"])
        if transition:
            write_event(*transition)
    return settled


def apply_command(state: dict[str, Any], command: str, now: float | None = None) -> dict[str, Any]:
    if command not in COMMANDS:
        raise ValueError(f"unknown command: {command}")
    state = advance(state, now)
    current_time = time.time() if now is None else now

    if command == "start":
        state["phase"] = "FOCUS"
        state["targetEndTimestamp"] = current_time + phase_duration_seconds(state, "FOCUS")
        state["pausedRemainingMs"] = 0
        state["pausedPhase"] = "FOCUS"
    elif command == "pause" and state["phase"] in ACTIVE_PHASES:
        state["pausedRemainingMs"] = max(
            0,
            int((float(state["targetEndTimestamp"]) - current_time) * 1000),
        )
        state["pausedPhase"] = state["phase"]
        state["targetEndTimestamp"] = 0.0
        state["phase"] = "PAUSED"
    elif command == "resume" and state["phase"] == "PAUSED":
        resumed_phase = state.get("pausedPhase", "FOCUS")
        if resumed_phase not in ACTIVE_PHASES:
            resumed_phase = "FOCUS"
        remaining_ms = max(1, int(state.get("pausedRemainingMs", 0)))
        state["phase"] = resumed_phase
        state["targetEndTimestamp"] = current_time + remaining_ms / 1000
        state["pausedRemainingMs"] = 0
    elif command == "skip" and state["phase"] in BREAK_PHASES:
        state["phase"] = "FOCUS"
        state["targetEndTimestamp"] = current_time + phase_duration_seconds(state, "FOCUS")
        state["pausedRemainingMs"] = 0
        state["pausedPhase"] = "FOCUS"
    elif command == "reset":
        state = {**DEFAULT, **{key: state[key] for key in CONFIG_KEYS}}
    return normalize_state(state)


def wake_daemon() -> None:
    """Tell a running daemon that the deadline changed (SIGUSR1). The daemon
    writes its PID into its lock only after installing the handler."""
    try:
        descriptor = os.open(daemon_lock_path(), os.O_RDONLY)
    except OSError:
        return
    with os.fdopen(descriptor, encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return  # nobody holds the lock: no daemon
        except BlockingIOError:
            pass
        try:
            pid = int(lock.read().strip())
        except ValueError:
            return
    with contextlib.suppress(ProcessLookupError, PermissionError):
        os.kill(pid, signal.SIGUSR1)


def run_command(command: str, now: float | None = None) -> dict[str, Any]:
    with state_lock():
        current = settle(load(), now)
        state = apply_command(current, command, now)
        if state != current:
            save(state)
    if state != current:
        wake_daemon()
    return state


class Deadline:
    """Waits for a wall-clock deadline or a wake-up byte. timerfd on
    CLOCK_REALTIME fires on time after suspend and is cancelled (ECANCELED)
    when the clock is set, so the daemon re-reads the state on both."""

    def __init__(self) -> None:
        self.fd = None
        if hasattr(os, "timerfd_create"):
            self.fd = os.timerfd_create(time.CLOCK_REALTIME, flags=os.TFD_CLOEXEC | os.TFD_NONBLOCK)

    def wait(self, deadline: float | None, wake_fd: int) -> None:
        readers = [wake_fd]
        timeout = None
        if self.fd is not None:
            if deadline:
                os.timerfd_settime(self.fd, flags=os.TFD_TIMER_ABSTIME | os.TFD_TIMER_CANCEL_ON_SET,
                                   initial=deadline)
            else:
                os.timerfd_settime(self.fd, initial=0)
            readers.append(self.fd)
        elif deadline:
            timeout = min(FALLBACK_POLL_SECONDS, max(0.0, deadline - time.time()))
        ready, _, _ = select.select(readers, [], [], timeout)
        for fd in ready:
            with contextlib.suppress(BlockingIOError, InterruptedError, OSError):
                os.read(fd, 64)


def daemon() -> int:
    ensure_event_file()
    lock_path = daemon_lock_path()
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    with os.fdopen(descriptor, "r+", encoding="utf-8") as daemon_lock:
        try:
            fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        wake_read, wake_write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        signal.signal(signal.SIGUSR1, lambda *_: None)
        signal.set_wakeup_fd(wake_write)
        daemon_lock.seek(0)
        daemon_lock.truncate()
        daemon_lock.write(f"{os.getpid()}\n")
        daemon_lock.flush()
        deadline = Deadline()
        try:
            while True:
                with state_lock():
                    state = settle(load())
                running = state["phase"] in ACTIVE_PHASES
                deadline.wait(state["targetEndTimestamp"] if running else None, wake_read)
        except KeyboardInterrupt:
            return 0


def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] == "daemon":
        return daemon()
    command = argv[1] if len(argv) > 1 else "status"
    try:
        state = run_command(command)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    print(json.dumps(state, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
