#!/usr/bin/env python3
"""Cortetsu post-hook for Cortetsu scheme changes."""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Marker used by the installer to distinguish this managed wrapper from a
# pre-existing user postHook.
CORTETSU_BRAVE_ORIGIN_BRIDGE = True

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "cortetsu/scheme.json"
POLICY = Path("/etc/brave/policies/managed/cortetsu.json")
def load_state() -> dict:
    try:
        obj = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Cortetsu postHook: cannot read {STATE}: {exc}", file=sys.stderr)
        return {}
    return obj if isinstance(obj, dict) else {}


def normalise_hex(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    value = value.strip().lstrip("#")
    if len(value) != 6:
        return None
    try:
        int(value, 16)
    except ValueError:
        return None
    return value.upper()


def detect_brave_origin() -> str | None:
    for name in ("brave-origin", "brave-origin-stable"):
        path = shutil.which(name)
        if path:
            return path
    return None


def apply_brave_origin() -> None:
    colours = load_state().get("colours")
    if not isinstance(colours, dict):
        colours = {}
    colour = None
    for key in ("surface", "background", "surfaceContainer"):
        colour = normalise_hex(colours.get(key))
        if colour:
            break
    if not colour:
        print("Cortetsu postHook: scheme has no usable surface/background colour", file=sys.stderr)
        return

    payload = {
        "BrowserThemeColor": f"#{colour}",
        "BrowserColorScheme": "device",
    }

    try:
        # The installer provisions only this file as user-writable.  The
        # managed policy directory itself remains root-owned.
        POLICY.write_text(json.dumps(payload, separators=(",", ":")) + "\n", encoding="utf-8")
    except OSError as exc:
        print(f"Cortetsu postHook: cannot update Brave policy {POLICY}: {exc}", file=sys.stderr)
        return

    browser = detect_brave_origin()
    if browser:
        try:
            subprocess.Popen(
                [browser, "--refresh-platform-policy", "--no-startup-window"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            print(f"Cortetsu postHook: Brave Origin refresh warning: {exc}", file=sys.stderr)


if __name__ == "__main__":
    apply_brave_origin()
