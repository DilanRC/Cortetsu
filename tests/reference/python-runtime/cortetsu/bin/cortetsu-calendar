#!/usr/bin/env python3
"""Read-only Google Calendar bridge for Cortetsu.

Only CalendarList.list and Events.list are used. Refresh tokens live in Secret
Service; configuration and cache files never contain credentials.
"""
from __future__ import annotations

import argparse
import base64
import contextlib
import fcntl
import hashlib
import http.server
import json
import os
import secrets
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Iterator

SCOPES = (
    "https://www.googleapis.com/auth/calendar.events.readonly",
    "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
)
AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
API_ROOT = "https://www.googleapis.com/calendar/v3"
SERVICE = "cortetsu-google-calendar"
STALE_SECONDS = 900
LOOKBACK_DAYS = 62
LOOKAHEAD_DAYS = 370
CALLBACK_TIMEOUT_SECONDS = 300


class CalendarError(RuntimeError):
    """Expected integration failure with a stable, non-sensitive error code."""


def paths() -> tuple[Path, Path, Path]:
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "cortetsu"
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "cortetsu"
    return (
        config / "calendar-client.json",
        config / "calendar-selection.json",
        cache / "calendar-events.json",
    )


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, ValueError, OSError):
        return default


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def normalize_client(raw: Any) -> tuple[dict[str, Any] | None, str | None]:
    """Accept Google's Desktop ``installed`` document or a flat test form."""
    if not isinstance(raw, dict) or not raw:
        return None, "credential_error"
    if "installed" in raw:
        client = raw["installed"]
        if not isinstance(client, dict):
            return None, "credential_error"
    elif "web" in raw:
        return None, "credential_error"
    else:
        client = raw
    client_id = client.get("client_id") if isinstance(client, dict) else None
    if not isinstance(client_id, str) or not client_id.strip():
        return None, "credential_error"
    return client, None


def _secret_tool() -> str:
    executable = shutil.which("secret-tool")
    if not executable:
        raise CalendarError("secret_service_unavailable")
    return executable


def _secret_lookup(service: str) -> str | None:
    process = subprocess.run(
        [_secret_tool(), "lookup", "service", service],
        capture_output=True,
        text=True,
        check=False,
        timeout=10,
    )
    value = process.stdout.strip()
    return value if process.returncode == 0 and value else None


def secret_get() -> str | None:
    return _secret_lookup(SERVICE)


def secret_set(token: str) -> None:
    subprocess.run(
        [
            _secret_tool(),
            "store",
            "--label",
            "Cortetsu Google Calendar refresh token",
            "service",
            SERVICE,
        ],
        input=token,
        text=True,
        check=True,
        timeout=15,
    )


def secret_clear() -> None:
    tool = _secret_tool()
    for service in (SERVICE,):
        subprocess.run(
            [tool, "clear", "service", service],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )


def api_get(access_token: str, path: str, params: dict[str, Any]) -> dict[str, Any]:
    url = API_ROOT + path + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {access_token}"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def refresh_access(client: dict[str, Any], refresh_token: str) -> str:
    body = urllib.parse.urlencode(
        {
            "client_id": client["client_id"],
            "client_secret": client.get("client_secret", ""),
            "refresh_token": refresh_token,
            "grant_type": "refresh_token",
        }
    ).encode()
    request = urllib.request.Request(TOKEN_URL, data=body, method="POST")
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.load(response)
    access_token = payload.get("access_token")
    if not isinstance(access_token, str) or not access_token:
        raise CalendarError("token_response_invalid")
    return access_token


def parse_callback_query(raw_query: str, expected_state: str) -> tuple[str | None, str | None]:
    values = urllib.parse.parse_qs(raw_query)
    received_state = values.get("state", [None])[0]
    if not received_state or not secrets.compare_digest(received_state, expected_state):
        return None, "oauth_state_mismatch"
    provider_error = values.get("error", [None])[0]
    if provider_error:
        return None, "oauth_denied"
    code = values.get("code", [None])[0]
    if not code:
        return None, "oauth_code_missing"
    return code, None


class CallbackServer(http.server.HTTPServer):
    expected_state: str
    result: tuple[str | None, str | None] | None


class Callback(http.server.BaseHTTPRequestHandler):
    server: CallbackServer

    def do_GET(self) -> None:  # noqa: N802
        code, error = parse_callback_query(
            urllib.parse.urlparse(self.path).query,
            self.server.expected_state,
        )
        # A random request to localhost must not cancel the valid OAuth flow.
        if self.server.result is None and error != "oauth_state_mismatch":
            self.server.result = (code, error)
        status = 200 if code else 400
        message = (
            "Cortetsu authorization received. You can close this tab."
            if code
            else "Cortetsu could not validate the authorization response."
        )
        body = message.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_: Any) -> None:
        return


def authorize(client: dict[str, Any]) -> str:
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    expected_state = secrets.token_urlsafe(32)
    server = CallbackServer(("127.0.0.1", 0), Callback)
    server.expected_state = expected_state
    server.result = None
    server.timeout = 1.0
    redirect = f"http://127.0.0.1:{server.server_port}/oauth2callback"
    query = {
        "client_id": client["client_id"],
        "redirect_uri": redirect,
        "response_type": "code",
        "scope": " ".join(SCOPES),
        "access_type": "offline",
        "prompt": "consent",
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "state": expected_state,
    }
    auth_url = AUTH_URL + "?" + urllib.parse.urlencode(query)
    if not webbrowser.open(auth_url):
        print(f"Open this URL to authorize Cortetsu:\n{auth_url}", file=sys.stderr)

    deadline = time.monotonic() + CALLBACK_TIMEOUT_SECONDS
    try:
        while server.result is None and time.monotonic() < deadline:
            server.handle_request()
    finally:
        server.server_close()

    if server.result is None:
        raise CalendarError("oauth_timeout")
    code, error = server.result
    if error or not code:
        raise CalendarError(error or "oauth_code_missing")

    body = urllib.parse.urlencode(
        {
            "client_id": client["client_id"],
            "client_secret": client.get("client_secret", ""),
            "code": code,
            "code_verifier": verifier,
            "grant_type": "authorization_code",
            "redirect_uri": redirect,
        }
    ).encode()
    request = urllib.request.Request(TOKEN_URL, data=body, method="POST")
    with urllib.request.urlopen(request, timeout=20) as response:
        token_payload = json.load(response)
    access_token = token_payload.get("access_token")
    refresh_token = token_payload.get("refresh_token")
    if not isinstance(access_token, str) or not access_token:
        raise CalendarError("token_response_invalid")
    if not isinstance(refresh_token, str) or not refresh_token:
        raise CalendarError("refresh_token_missing")
    secret_set(refresh_token)
    return access_token


def token(client: dict[str, Any]) -> str:
    refresh_token = secret_get()
    if not refresh_token:
        return authorize(client)
    try:
        return refresh_access(client, refresh_token)
    except urllib.error.HTTPError as exc:
        if exc.code not in (400, 401):
            raise
        secret_clear()
        return authorize(client)


def calendar_list(access_token: str) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    page: str | None = None
    while True:
        params: dict[str, Any] = {"maxResults": 250}
        if page:
            params["pageToken"] = page
        data = api_get(access_token, "/users/me/calendarList", params)
        for item in data.get("items", []):
            calendar_id = item.get("id")
            if not isinstance(calendar_id, str) or not calendar_id:
                continue
            result.append(
                {
                    "calendarId": calendar_id,
                    "calendarName": item.get("summary", calendar_id),
                    "calendarColor": item.get("backgroundColor", ""),
                    "selected": bool(item.get("selected", False)),
                    "primary": bool(item.get("primary", False)),
                }
            )
        page = data.get("nextPageToken")
        if not page:
            return result


def normalize_event(item: Any, calendar: dict[str, Any]) -> dict[str, Any] | None:
    if not isinstance(item, dict):
        return None
    event_id = item.get("id")
    begin = item.get("start")
    finish = item.get("end")
    if not isinstance(event_id, str) or not isinstance(begin, dict) or not isinstance(finish, dict):
        return None
    start = begin.get("dateTime", begin.get("date"))
    end = finish.get("dateTime", finish.get("date"))
    if not isinstance(start, str) or not isinstance(end, str):
        return None
    return {
        "calendarId": calendar["calendarId"],
        "calendarName": calendar["calendarName"],
        "calendarColor": calendar["calendarColor"],
        "eventId": event_id,
        "title": item.get("summary") or "(untitled)",
        "start": start,
        "end": end,
        "allDay": "date" in begin,
        "location": item.get("location", ""),
        "htmlLink": item.get("htmlLink", ""),
    }


def events(
    access_token: str,
    calendars: list[dict[str, Any]],
    start: str,
    end: str,
    timezone_name: str,
) -> tuple[list[dict[str, Any]], list[dict[str, str]]]:
    all_events: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    for calendar in calendars:
        try:
            page: str | None = None
            while True:
                params: dict[str, Any] = {
                    "singleEvents": "true",
                    "showDeleted": "false",
                    "orderBy": "startTime",
                    "timeMin": start,
                    "timeMax": end,
                    "timeZone": timezone_name,
                    "maxResults": 2500,
                }
                if page:
                    params["pageToken"] = page
                data = api_get(
                    access_token,
                    "/calendars/" + urllib.parse.quote(calendar["calendarId"], safe="") + "/events",
                    params,
                )
                for item in data.get("items", []):
                    normalized = normalize_event(item, calendar)
                    if normalized:
                        all_events.append(normalized)
                page = data.get("nextPageToken")
                if not page:
                    break
        except (urllib.error.URLError, urllib.error.HTTPError, KeyError, ValueError, TypeError) as exc:
            failures.append(
                {
                    "calendarId": calendar.get("calendarId", "unknown"),
                    "error": type(exc).__name__,
                }
            )
    all_events.sort(key=lambda event: (event["start"], event["calendarId"], event["eventId"]))
    return all_events, failures


def local_timezone_name() -> str:
    configured = os.environ.get("TZ", "").lstrip(":")
    if configured:
        return configured
    tzinfo = datetime.now().astimezone().tzinfo
    key = getattr(tzinfo, "key", None)
    if isinstance(key, str) and key:
        return key
    try:
        resolved = Path("/etc/localtime").resolve()
        parts = resolved.parts
        zoneinfo_index = parts.index("zoneinfo")
        candidate = "/".join(parts[zoneinfo_index + 1 :])
        if candidate:
            return candidate
    except (OSError, ValueError):
        pass
    return "UTC"


def cache_is_fresh(cache_path: Path, now: float | None = None) -> bool:
    payload = load_json(cache_path, {})
    fetched_at = payload.get("fetchedAt") if isinstance(payload, dict) else None
    try:
        age = (time.time() if now is None else now) - float(fetched_at)
    except (TypeError, ValueError):
        return False
    return 0 <= age < STALE_SECONDS


@contextlib.contextmanager
def sync_lock(cache_path: Path) -> Iterator[bool]:
    lock_path = cache_path.with_name("calendar-sync.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


def sync(force: bool = False) -> int:
    client_path, selection_path, cache_path = paths()
    if not client_path.exists():
        emit({"status": "auth_required", "clientPath": str(client_path)})
        return 2

    with sync_lock(cache_path) as acquired:
        if not acquired:
            emit({"status": "sync_in_progress", "cache": str(cache_path)})
            return 0
        if not force and cache_is_fresh(cache_path):
            cached = load_json(cache_path, {})
            emit(
                {
                    "status": "cached",
                    "cache": str(cache_path),
                    "eventCount": len(cached.get("events", [])),
                    "fetchedAt": cached.get("fetchedAt"),
                }
            )
            return 0

        client, credential_error = normalize_client(load_json(client_path, {}))
        if credential_error or client is None:
            emit({"status": "credential_error", "clientPath": str(client_path)})
            return 2

        try:
            access_token = token(client)
            calendars = calendar_list(access_token)
            selection = load_json(selection_path, {})
            enabled = selection.get("enabled") if isinstance(selection, dict) else None
            if not isinstance(enabled, list):
                enabled = [
                    calendar["calendarId"]
                    for calendar in calendars
                    if calendar["selected"] or calendar["primary"]
                ]
                save_json(selection_path, {"enabled": enabled, "initialized": True})
            enabled_ids = {value for value in enabled if isinstance(value, str)}
            chosen = [calendar for calendar in calendars if calendar["calendarId"] in enabled_ids]

            now = datetime.now().astimezone()
            start = (now - timedelta(days=LOOKBACK_DAYS)).isoformat()
            end = (now + timedelta(days=LOOKAHEAD_DAYS)).isoformat()
            timezone_name = local_timezone_name()
            items, failures = events(access_token, chosen, start, end, timezone_name)
            payload = {
                "schema": 1,
                "fetchedAt": time.time(),
                "timezone": timezone_name,
                "range": {"start": start, "end": end},
                "calendars": calendars,
                "events": items,
                "failures": failures,
            }
            save_json(cache_path, payload)
            status = "partial" if failures else "ok"
            emit(
                {
                    "status": status,
                    "cache": str(cache_path),
                    "eventCount": len(items),
                    "failedCalendars": failures,
                }
            )
            return 4 if failures else 0
        except CalendarError as exc:
            emit({"status": str(exc)})
            return 3
        except (
            urllib.error.URLError,
            urllib.error.HTTPError,
            KeyError,
            ValueError,
            TypeError,
            OSError,
            subprocess.SubprocessError,
        ) as exc:
            emit({"status": "error", "error": type(exc).__name__})
            return 3


def set_selection(calendar_id: str, enabled: bool) -> int:
    _, selection_path, _ = paths()
    selection = load_json(selection_path, {"enabled": [], "initialized": True})
    existing = selection.get("enabled", []) if isinstance(selection, dict) else []
    ids = {value for value in existing if isinstance(value, str)}
    if enabled:
        ids.add(calendar_id)
    else:
        ids.discard(calendar_id)
    result = {"enabled": sorted(ids), "initialized": True}
    save_json(selection_path, result)
    emit({"status": "selection_updated", **result})
    return 0


def status() -> int:
    client_path, _, cache_path = paths()
    cached = load_json(cache_path, {})
    fetched_at = cached.get("fetchedAt") if isinstance(cached, dict) else None
    age = None
    try:
        age = max(0, int(time.time() - float(fetched_at)))
    except (TypeError, ValueError):
        pass
    emit(
        {
            "status": "ready" if client_path.exists() else "auth_required",
            "clientPath": str(client_path),
            "cache": str(cache_path),
            "cacheAgeSeconds": age,
            "eventCount": len(cached.get("events", [])) if isinstance(cached, dict) else 0,
        }
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=["sync", "disconnect", "scopes", "set-selection", "status"],
    )
    parser.add_argument("calendar_id", nargs="?")
    parser.add_argument("enabled", nargs="?", choices=["true", "false"])
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    if args.command == "scopes":
        print("\n".join(SCOPES))
        return 0
    if args.command == "disconnect":
        try:
            secret_clear()
        except CalendarError as exc:
            emit({"status": str(exc)})
            return 3
        emit({"status": "disconnected"})
        return 0
    if args.command == "status":
        return status()
    if args.command == "set-selection":
        if not args.calendar_id or args.enabled is None:
            return 2
        return set_selection(args.calendar_id, args.enabled == "true")
    return sync(force=args.force)


if __name__ == "__main__":
    raise SystemExit(main())
